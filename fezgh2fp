#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezgh2fp — GitHub repo → Flatpak (build, install, update)
# ─────────────── CONFIG ───────────────
FP_BUILD_DIR="$HOME/.local/share/fezgh2fp/builds"
FP_REPO_DIR="$HOME/.local/share/fezgh2fp/repos"
# ──────────────────────────────────────
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"
mkdir -p "$FP_BUILD_DIR" "$FP_REPO_DIR"

_check_deps() {
    local missing=()
    command -v flatpak-builder &>/dev/null || missing+=(flatpak-builder)
    command -v git             &>/dev/null || missing+=(git)
    [[ ${#missing[@]} -gt 0 ]] && echo "Brakuje: ${missing[*]}  →  sudo pacman -S ${missing[*]}" && return 1
}

_app_id_from_url() {
    local url="$1"
    local user; user=$(echo "$url" | sed 's|.*github.com/||' | cut -d'/' -f1)
    local repo; repo=$(echo "$url" | sed 's|.*github.com/||' | cut -d'/' -f2 | sed 's/\.git$//')
    echo "io.github.${user}.${repo}"
}

_list_local() {
    local -n _out="$1"; _out=()
    for d in "$FP_REPO_DIR"/*/; do [[ -d "$d" ]] && _out+=("$d"); done
}

build() {
    _check_deps || return 1
    local url="${1}"
    [[ -z "$url" ]] && { echo -n "GitHub URL: "; read -r url; }
    [[ -z "$url" ]] && { echo "URL wymagany"; return 1; }
    [[ "$url" != *github.com* ]] && { echo "Podaj URL GitHub: https://github.com/user/repo"; return 1; }

    local app_id; app_id=$(_app_id_from_url "$url")
    local repo_name; repo_name=$(echo "$url" | sed 's|.*/||' | sed 's/\.git$//')
    local repo_dir="$FP_REPO_DIR/$repo_name"
    local build_dir="$FP_BUILD_DIR/$app_id"

    echo "App ID:  $app_id"
    echo "Klonuje: $url"
    git clone --depth=1 "$url" "$repo_dir" 2>/dev/null || {
        echo "Aktualizuje istniejace repo..."
        git -C "$repo_dir" pull
    }

    local manifest="$repo_dir/flatpak/$app_id.yaml"
    [[ ! -f "$manifest" ]] && manifest=$(find "$repo_dir" -name "*.yaml" -path "*/flatpak/*" | head -1)
    [[ ! -f "$manifest" ]] && manifest=$(find "$repo_dir" -name "*.json" -path "*/flatpak/*" | head -1)

    if [[ -z "$manifest" ]]; then
        echo "Brak manifest flatpak w repo. Tworze minimalny..."
        mkdir -p "$repo_dir/flatpak"
        manifest="$repo_dir/flatpak/$app_id.yaml"
        cat > "$manifest" << EOF
app-id: $app_id
runtime: org.freedesktop.Platform
runtime-version: '23.08'
sdk: org.freedesktop.Sdk
command: $repo_name
modules:
  - name: $repo_name
    buildsystem: simple
    build-commands:
      - install -Dm755 $repo_name /app/bin/$repo_name
    sources:
      - type: dir
        path: ..
EOF
        echo "Manifest: $manifest"
        echo "Edytuj manifest i uruchom ponownie build"
        return
    fi

    echo "Manifest: $manifest"
    flatpak-builder --force-clean "$build_dir" "$manifest"
    flatpak-builder --user --install --force-clean "$build_dir" "$manifest"
    echo "Zainstalowano: $app_id"
    echo "$app_id|$url|$manifest" >> "$FP_REPO_DIR/.index"
}

update() {
    local app="${1}"
    if [[ -z "$app" ]]; then
        [[ ! -f "$FP_REPO_DIR/.index" ]] && { echo "Brak zbudowanych flatpakow"; return 1; }
        local pick; pick=$(awk -F'|' '{printf "%-40s  %s\n", $1, $2}' "$FP_REPO_DIR/.index" | _fzf_pick "aktualizuj> ")
        app=$(awk '{print $1}' <<< "$pick")
    fi

    local url; url=$(grep "^$app|" "$FP_REPO_DIR/.index" 2>/dev/null | cut -d'|' -f2)
    [[ -z "$url" ]] && { echo "Brak wpisu dla: $app"; return 1; }
    build "$url"
}

list() {
    [[ ! -f "$FP_REPO_DIR/.index" ]] && echo "Brak zbudowanych flatpakow" && return
    echo "Zbudowane flatpaki:"
    while IFS='|' read -r app url manifest; do
        printf "  %-40s  %s\n" "$app" "$url"
    done < "$FP_REPO_DIR/.index"
}

status() {
    command -v flatpak-builder &>/dev/null && echo "flatpak-builder: OK" || echo "flatpak-builder: BRAK"
    echo "Builds: $FP_BUILD_DIR"
    echo "Repos:  $FP_REPO_DIR"
    echo "Zbudowane: $(wc -l < "$FP_REPO_DIR/.index" 2>/dev/null || echo 0)"
}

info() {
    status; echo
    echo "fezgh2fp build [url]    # zbuduj + zainstaluj flatpak z GitHub"
    echo "fezgh2fp update [app]   # zaktualizuj istniejacy flatpak"
    echo "fezgh2fp list           # lista zbudowanych flatpakow"
    echo "fezgh2fp status         # status"
    echo "fezgh2fp -c [flagi]     # -b <url> -u <app> -l"
}

all() { list; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(build update list status info)
    local descs=(
        "zbuduj + zainstaluj flatpak z GitHub URL"
        "zaktualizuj istniejacy flatpak"
        "lista zbudowanych flatpakow"
        "status narzedzi"
        "info + komendy"
    )
    _fzf_menu "fezgh2fp | $(wc -l < "$FP_REPO_DIR/.index" 2>/dev/null || echo 0) flatpakow" cmds descs
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -b|--build)  shift; build "$1" ;;
            -u|--update) shift; update "$1" ;;
            -l|--list)   list ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -b <url> -u <app> -l"; return 1 ;;
        esac
        shift
    done
}

case "${1:-info}" in
    tui|-t)  tui ;;
    cli|-c)  cli "$@" ;;
    all|-a)  all ;;
    info|-i) info ;;
    build)   build "${@:2}" ;;
    update)  update "${@:2}" ;;
    *)       _do "$1" || echo "Uzycie: fezgh2fp [build|update|list|status|tui|cli|-a|-i]" ;;
esac
