#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezman — fzf TUI do przegladania manpage'y, z live preview i szukaniem po opisie
# ─────────────── CONFIG ───────────────
PREVIEW_WIDTH="right:70%"
# ──────────────────────────────────────
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_need_fzf() { command -v fzf &>/dev/null || { _err "Brakuje: fzf  →  sudo pacman -S fzf"; return 1; }; }

_names() { man -k . 2>/dev/null | awk -F'[ (]' '{print $1}' | sort -u; }

browse() {
    _need_fzf || return 1
    local sel
    sel=$(_names | fzf --prompt="man> " \
        --preview 'man {} 2>/dev/null | col -bx' --preview-window="$PREVIEW_WIDTH")
    if [[ -n "$sel" ]]; then
        man "$sel"
    fi
}

search() {
    _need_fzf || return 1
    local q="${1:-}"
    [[ -z "$q" ]] && { echo -n "Szukaj (opis): "; read -r q; }
    [[ -z "$q" ]] && return 1
    local hits; hits=$(man -k "$q" 2>/dev/null)
    [[ -z "$hits" ]] && { _err "Brak wynikow dla: $q"; return 1; }
    local sel; sel=$(echo "$hits" | fzf --prompt="man ($q)> " \
        --preview 'man $(echo {} | awk -F"[ (]" "{print \$1}") 2>/dev/null | col -bx' \
        --preview-window="$PREVIEW_WIDTH")
    if [[ -n "$sel" ]]; then
        man "$(echo "$sel" | awk -F'[ (]' '{print $1}')"
    fi
}

open() {
    local name="${1:-}"
    [[ -z "$name" ]] && { echo -n "Komenda: "; read -r name; }
    [[ -z "$name" ]] && return 1
    man "$name"
}

status() {
    command -v fzf &>/dev/null && echo "fzf: OK" || _err "fzf: BRAK"
    printf "Strony man: %s\n" "$(man -k . 2>/dev/null | wc -l)"
}

info() {
    status; echo
    echo "fezman                # przegladaj wszystkie manpage'y (fzf + preview)"
    echo "fezman search [fraza] # szukaj po opisie (apropos) + fzf + preview"
    echo "fezman open <nazwa>   # otworz konkretna strone wprost"
    echo "fezman -c [flagi]     # -b -s <fraza> -o <nazwa>"
}

all() { browse; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(browse search)
    local descs=(
        "przegladaj wszystkie manpage'y (fzf+preview)"
        "szukaj po opisie (apropos)"
    )
    _fzf_menu "fezman" cmds descs
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -b|--browse) browse ;;
            -s|--search) shift; search "${1:-}" ;;
            -o|--open)   shift; open "${1:-}" ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -b -s <fraza> -o <nazwa>"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)   tui ;;
    cli|-c)   cli "$@" ;;
    all|-a)   all ;;
    info|-i)  info ;;
    browse)   browse ;;
    search)   search "${2:-}" ;;
    open)     open "${2:-}" ;;
    status)   status ;;
    "")       tui ;;
    *)        open "$1" ;;
esac
