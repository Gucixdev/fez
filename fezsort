#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezsort — sortuje/organizuje pliki w folderze (rozszerzenie/data/rozmiar/duplikaty)
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_pick_dir() {
    local -n _d="$1"
    if [[ -n "${2:-}" ]]; then
        _d="$2"
    elif command -v fzf &>/dev/null; then
        _d=$(find . -maxdepth 5 -type d -not -path '*/.git*' 2>/dev/null | sort | fzf --prompt="Folder: ")
        _d="${_d:-.}"
    else
        echo -n "Folder [.]: "; read -r _d; _d="${_d:-.}"
    fi
    [[ -d "$_d" ]] || { _err "Brak folderu: $_d"; return 1; }
}

by_ext() {
    local dir; _pick_dir dir "${1:-}" || return 1
    local f name ext dest moved=0
    for f in "$dir"/*; do
        [[ -f "$f" ]] || continue
        name=$(basename "$f")
        if [[ "$name" == *.* ]]; then
            ext="${name##*.}"
        else
            ext="bez_rozszerzenia"
        fi
        dest="$dir/${ext,,}"
        mkdir -p "$dest"
        mv -n -- "$f" "$dest/" && ((moved++))
    done
    _ok "Przeniesiono: $moved plik(ow) wg rozszerzenia"
}

by_date() {
    local dir; _pick_dir dir "${1:-}" || return 1
    local f sub moved=0
    for f in "$dir"/*; do
        [[ -f "$f" ]] || continue
        sub=$(date -r "$f" +%Y-%m 2>/dev/null) || continue
        mkdir -p "$dir/$sub"
        mv -n -- "$f" "$dir/$sub/" && ((moved++))
    done
    _ok "Przeniesiono: $moved plik(ow) wg daty modyfikacji (RRRR-MM)"
}

by_size() {
    local dir; _pick_dir dir "${1:-}" || return 1
    local f size dest moved=0
    for f in "$dir"/*; do
        [[ -f "$f" ]] || continue
        size=$(stat -c%s "$f" 2>/dev/null) || continue
        if   (( size < 1048576 ));   then dest="male"     # <1MB
        elif (( size < 104857600 )); then dest="srednie"  # <100MB
        else                              dest="duze"
        fi
        mkdir -p "$dir/$dest"
        mv -n -- "$f" "$dir/$dest/" && ((moved++))
    done
    _ok "Przeniesiono: $moved plik(ow) wg rozmiaru (male<1MB, srednie<100MB, duze>=100MB)"
}

dedup() {
    local dir; _pick_dir dir "${1:-}" || return 1
    local tmp; tmp=$(mktemp)
    find "$dir" -maxdepth 1 -type f -exec sha256sum {} + > "$tmp" 2>/dev/null

    local hashes; hashes=$(awk '{print $1}' "$tmp" | sort | uniq -d)
    if [[ -z "$hashes" ]]; then
        _ok "Brak duplikatow w: $dir"
        rm -f "$tmp"
        return 0
    fi

    local to_delete=() h files first rest
    while IFS= read -r h; do
        mapfile -t files < <(awk -v hh="$h" '$1==hh{sub($1 FS,""); print}' "$tmp")
        first="${files[0]}"
        rest=("${files[@]:1}")
        if command -v fzf &>/dev/null; then
            local picks; mapfile -t picks < <(printf '%s\n' "${rest[@]}" \
                | fzf -m --bind space:toggle+down --prompt="duplikat (oryginal: $(basename "$first"))> ")
            to_delete+=("${picks[@]}")
        else
            to_delete+=("${rest[@]}")
        fi
    done <<< "$hashes"
    rm -f "$tmp"

    [[ ${#to_delete[@]} -eq 0 ]] && { echo "Nic nie zaznaczono do usuniecia"; return 0; }
    echo "Do usuniecia:"; printf '  - %s\n' "${to_delete[@]}"
    echo -n "Potwierdzasz? [t/N] "; read -r yn
    [[ "$yn" == [tT] ]] || { echo "Anulowano"; return 0; }
    rm -f -- "${to_delete[@]}" && _ok "Usunieto: ${#to_delete[@]} duplikat(ow)"
}

status() {
    command -v fzf &>/dev/null && echo "fzf: OK" || _dim "fzf: brak (wybor folderu recznie, dedup usuwa wszystkie duplikaty bez wyboru)"
}

info() {
    status; echo
    echo "fezsort by_ext [folder]   # przenosi pliki do podfolderow wg rozszerzenia"
    echo "fezsort by_date [folder]  # przenosi pliki do podfolderow RRRR-MM wg daty"
    echo "fezsort by_size [folder]  # przenosi pliki do male/srednie/duze"
    echo "fezsort dedup [folder]    # znajdz duplikaty (sha256) i usun wybrane"
    echo "fezsort -c [flagi]        # -e -d -s -u [folder]"
}

all() { tui; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(by_ext by_date by_size dedup)
    local descs=(
        "wg rozszerzenia"
        "wg daty modyfikacji (RRRR-MM)"
        "wg rozmiaru (male/srednie/duze)"
        "znajdz i usun duplikaty (sha256)"
    )
    _fzf_menu "fezsort" cmds descs
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -e|--ext)  shift; by_ext "$1" ;;
            -d|--date) shift; by_date "$1" ;;
            -s|--size) shift; by_size "$1" ;;
            -u|--dup)  shift; dedup "$1" ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -e -d -s -u [folder]"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)  tui ;;
    cli|-c)  cli "$@" ;;
    all|-a)  all ;;
    info|-i) info ;;
    by_ext)  by_ext "${2:-}" ;;
    by_date) by_date "${2:-}" ;;
    by_size) by_size "${2:-}" ;;
    dedup)   dedup "${2:-}" ;;
    *)       _do "$1" || echo "Uzycie: fezsort [by_ext|by_date|by_size|dedup|tui|cli|-a|-i] [folder]" ;;
esac
