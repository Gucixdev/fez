#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezsort — sort/normalize structured files (JSON keys, YAML, lines, dedup)
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_pick_file() {
    local -n _f="$1"
    if [[ -n "${2:-}" ]]; then
        _f="$2"
    elif command -v fzf &>/dev/null; then
        _f=$(find . -maxdepth 4 -type f -not -path '*/.git/*' 2>/dev/null | fzf --prompt="Plik: " --preview="head -50 {}" --preview-window=down:10)
    else
        echo -n "Plik: "; read -r _f
    fi
    if [[ -z "$_f" || ! -f "$_f" ]]; then
        _err "Brak pliku: $_f"
        return 1
    fi
}

json() {
    local f; _pick_file f "${1:-}" || return 1
    command -v jq &>/dev/null || { _err "Brakuje: jq  →  sudo pacman -S jq"; return 1; }
    local tmp; tmp=$(mktemp)
    jq --sort-keys . "$f" > "$tmp" && mv "$tmp" "$f" && _ok "JSON posortowany: $f"
}

yaml() {
    local f; _pick_file f "${1:-}" || return 1
    command -v yq &>/dev/null || { _err "Brakuje: yq  →  pip install yq  lub  paru -S yq"; return 1; }
    local tmp; tmp=$(mktemp)
    yq --sort-keys . "$f" > "$tmp" && mv "$tmp" "$f" && _ok "YAML posortowany: $f"
}

lines() {
    local f; _pick_file f "${1:-}" || return 1
    local tmp; tmp=$(mktemp)
    sort "$f" > "$tmp" && mv "$tmp" "$f" && _ok "Linie posortowane: $f"
}

dedup() {
    local f; _pick_file f "${1:-}" || return 1
    local before; before=$(wc -l < "$f")
    local tmp; tmp=$(mktemp)
    awk '!seen[$0]++' "$f" > "$tmp" && mv "$tmp" "$f"
    local after; after=$(wc -l < "$f")
    _ok "Dedup: $f  ($before → $after linii, usunieto $((before-after)))"
}

sort_lines_dedup() {
    local f; _pick_file f "${1:-}" || return 1
    local tmp; tmp=$(mktemp)
    sort -u "$f" > "$tmp" && mv "$tmp" "$f" && _ok "Posortowano + dedup: $f"
}

status() {
    command -v jq &>/dev/null && echo "jq:  OK" || _err "jq:  BRAK"
    command -v yq &>/dev/null && echo "yq:  OK" || _err "yq:  BRAK"
    command -v fzf &>/dev/null && echo "fzf: OK" || _dim "fzf: brak (wybor pliku recznie)"
}

info() {
    status; echo
    echo "fezsort json [plik]         # sortuj klucze JSON"
    echo "fezsort yaml [plik]         # sortuj klucze YAML"
    echo "fezsort lines [plik]        # sortuj linie"
    echo "fezsort dedup [plik]        # usuN duplikaty linii"
    echo "fezsort sort_lines_dedup    # sortuj + dedup"
    echo "fezsort -c [flagi]          # -j -y -l -d -u"
}

all() { echo "Wybierz plik i operacje z TUI"; tui; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(json yaml lines dedup sort_lines_dedup status info)
    local descs=(
        "sortuj klucze JSON"
        "sortuj klucze YAML"
        "sortuj linie alfabetycznie"
        "usun duplikaty linii"
        "sortuj linie + usun duplikaty"
        "status narzedzi"
        "info + komendy"
    )
    _fzf_menu "fezsort" cmds descs
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -j|--json)  shift; json "$1" ;;
            -y|--yaml)  shift; yaml "$1" ;;
            -l|--lines) shift; lines "$1" ;;
            -d|--dedup) shift; dedup "$1" ;;
            -u|--uniq)  shift; sort_lines_dedup "$1" ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -j <plik> -y <plik> -l <plik> -d <plik> -u <plik>"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)           tui ;;
    cli|-c)           cli "$@" ;;
    all|-a)           all ;;
    info|-i)          info ;;
    json)             json "${@:2}" ;;
    yaml)             yaml "${@:2}" ;;
    lines)            lines "${@:2}" ;;
    dedup)            dedup "${@:2}" ;;
    sort_lines_dedup) sort_lines_dedup "${@:2}" ;;
    *)                _do "$1" || echo "Uzycie: fezsort [json|yaml|lines|dedup|sort_lines_dedup|tui|cli|-a|-i]" ;;
esac
