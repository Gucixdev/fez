#!/usr/bin/env bash
# feztrash — safe rm replacement: moves files to ~/.trash instead of deleting
# duplicate names get a numeric suffix (file.txt -> file_1.txt -> file_2.txt)
# bez argumentu/nieznanej komendy == traktuje argumenty jako pliki do skasowania
# ─────────────── CONFIG ───────────────
TRASH_DIR="$HOME/.trash"
LOG_FILE="$TRASH_DIR/.trash.log"   # ts \t oryginalna_sciezka \t nazwa_w_koszu
KEEP_DAYS=30                       # domyslny wiek dla purge
# ──────────────────────────────────────
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_unique_name() {
    local name="$1" base ext dest="$1" n=1
    if [[ "$name" == *.* && "$name" != .* ]]; then
        base="${name%.*}"; ext=".${name##*.}"
    else
        base="$name"; ext=""
    fi
    while [[ -e "$TRASH_DIR/$dest" ]]; do
        dest="${base}_${n}${ext}"
        ((n++))
    done
    printf '%s' "$dest"
}

_lookup_orig() {
    [[ -f "$LOG_FILE" ]] || return 1
    tac "$LOG_FILE" | awk -F'\t' -v n="$1" '$3==n{print $2; exit}'
}

put() {
    if [[ $# -eq 0 ]]; then
        local f; echo -n "Plik/folder: "; read -r f; set -- "$f"
    fi
    mkdir -p "$TRASH_DIR"
    local f
    for f in "$@"; do
        [[ -e "$f" || -L "$f" ]] || { echo "Nie istnieje: $f"; continue; }
        local abs base dest
        abs=$(realpath -m -- "$f")
        base=$(basename -- "$f")
        dest=$(_unique_name "$base")
        mv -- "$f" "$TRASH_DIR/$dest"
        printf '%s\t%s\t%s\n' "$(date +%s)" "$abs" "$dest" >> "$LOG_FILE"
        echo "→ .trash/$dest   (byl: $abs)"
    done
}

list() {
    mkdir -p "$TRASH_DIR"
    local name i=0
    printf "%-4s %-30s %-17s %s\n" "#" "w koszu" "usunieto" "oryginal"
    while IFS= read -r name; do
        ((i++))
        local ts orig line
        line=$(tac "$LOG_FILE" 2>/dev/null | awk -F'\t' -v n="$name" '$3==n{print $1"\t"$2; exit}')
        ts="${line%%$'\t'*}"; orig="${line#*$'\t'}"
        printf "%-4s %-30s %-17s %s\n" "$i" "$name" "$([[ -n "$ts" ]] && date -d "@$ts" '+%Y-%m-%d %H:%M' || echo '?')" "${orig:-?}"
    done < <(find "$TRASH_DIR" -mindepth 1 -maxdepth 1 -not -name "$(basename "$LOG_FILE")" -printf '%f\n' 2>/dev/null | sort)
    [[ $i -eq 0 ]] && echo "Kosz pusty"
}

restore() {
    local name="$1"
    if [[ -z "$name" ]]; then
        if command -v fzf &>/dev/null; then
            name=$(find "$TRASH_DIR" -mindepth 1 -maxdepth 1 -not -name "$(basename "$LOG_FILE")" -printf '%f\n' 2>/dev/null | fzf --prompt="Przywroc: ")
        else
            echo -n "Nazwa w koszu: "; read -r name
        fi
    fi
    [[ -z "$name" ]] && return 1
    [[ -e "$TRASH_DIR/$name" ]] || { echo "Brak w koszu: $name"; return 1; }
    local orig; orig=$(_lookup_orig "$name")
    [[ -z "$orig" ]] && orig="$PWD/$name"
    if [[ -e "$orig" ]]; then
        echo -n "Cel istnieje ($orig) — nadpisac? [t/N] "; read -r yn
        [[ "$yn" == [tT] ]] || return 1
    fi
    mkdir -p "$(dirname "$orig")"
    mv -- "$TRASH_DIR/$name" "$orig" && echo "Przywrocono: $orig"
}

purge() {
    local days="${1:-$KEEP_DAYS}"
    [[ -f "$LOG_FILE" ]] || { echo "Kosz pusty"; return; }
    local cutoff=$(( $(date +%s) - days*86400 )) removed=0
    local tmp; tmp=$(mktemp)
    while IFS=$'\t' read -r ts orig name; do
        if [[ -n "$name" && -e "$TRASH_DIR/$name" ]]; then
            if (( ts < cutoff )); then
                rm -rf -- "$TRASH_DIR/$name"
                ((removed++))
            else
                printf '%s\t%s\t%s\n' "$ts" "$orig" "$name" >> "$tmp"
            fi
        fi
    done < "$LOG_FILE"
    mv "$tmp" "$LOG_FILE"
    echo "Trwale usunieto: $removed (starsze niz ${days}d)"
}

empty() {
    mkdir -p "$TRASH_DIR"
    local n; n=$(find "$TRASH_DIR" -mindepth 1 -maxdepth 1 -not -name "$(basename "$LOG_FILE")" 2>/dev/null | wc -l)
    [[ "$n" -eq 0 ]] && { echo "Kosz pusty"; return; }
    echo "Kosz: $n element(ow), $(du -sh "$TRASH_DIR" 2>/dev/null | cut -f1)"
    echo -n "Usunac trwale WSZYSTKO? [t/N] "; read -r yn
    [[ "$yn" == [tT] ]] || { echo "Anulowano"; return; }
    find "$TRASH_DIR" -mindepth 1 -maxdepth 1 -not -name "$(basename "$LOG_FILE")" -exec rm -rf -- {} +
    : > "$LOG_FILE"
    echo "Kosz oprozniony"
}

status() {
    mkdir -p "$TRASH_DIR"
    local n; n=$(find "$TRASH_DIR" -mindepth 1 -maxdepth 1 -not -name "$(basename "$LOG_FILE")" 2>/dev/null | wc -l)
    printf "Kosz:      %s\n" "$TRASH_DIR"
    printf "Elementy:  %s\n" "$n"
    printf "Rozmiar:   %s\n" "$(du -sh "$TRASH_DIR" 2>/dev/null | cut -f1)"
}

info() {
    status; echo
    echo "feztrash <plik...>          # domyslnie: przenosi do kosza (zamiast rm -rf)"
    echo "feztrash put <plik...>      # to samo jawnie"
    echo "feztrash list               # zawartosc kosza"
    echo "feztrash restore [nazwa]    # przywraca do oryginalnej sciezki (fzf jesli brak nazwy)"
    echo "feztrash purge [dni=$KEEP_DAYS]  # trwale usuwa starsze niz N dni"
    echo "feztrash empty              # oproznia caly kosz (z potwierdzeniem)"
    echo "feztrash status             # rozmiar / ilosc"
    echo "feztrash -c [flagi]         # -p -l -r -P -e -s"
}

all() { status; echo; list; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(list restore purge empty status info)
    local descs=(
        "zawartosc kosza"
        "przywroc plik"
        "trwale usun starsze niz N dni"
        "oproznij caly kosz"
        "rozmiar / ilosc"
        "info + komendy"
    )
    while true; do
        echo "=== feztrash | $(status | awk -F': *' '/Elementy/{print $2}') w koszu ==="
        for i in "${!cmds[@]}"; do printf "%2d) %-10s  %s\n" $((i+1)) "${cmds[$i]}" "${descs[$i]}"; done
        echo " 0) wyjdz"
        echo -n "Wybierz: "; read -r n
        _tui_dispatch "$n" cmds || break
        echo; echo -n "[Enter]"; read -r
    done
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--put)     shift; put "$@"; break ;;
            -l|--list)    list ;;
            -r|--restore) shift; restore "${1:-}" ;;
            -P|--purge)   shift; purge "${1:-}" ;;
            -e|--empty)   empty ;;
            -s|--status)  status ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -p <pliki...> -l -r <nazwa> -P <dni> -e -s"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)      tui ;;
    cli|-c)      cli "$@" ;;
    all|-a)      all ;;
    info|-i)     info ;;
    put)         shift; put "$@" ;;
    list)        list ;;
    restore)     shift; restore "${1:-}" ;;
    purge)       shift; purge "${1:-}" ;;
    empty)       empty ;;
    status)      status ;;
    *)           put "$@" ;;   # domyslnie: nieznana komenda == lista plikow do wyrzucenia
esac
