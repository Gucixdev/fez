#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezcleaner — system cleanup (RAM, logs, cache, packages)
# ─────────────── CONFIG ───────────────
LOG_DAYS=7        # logi starsze niz N dni
PACMAN_KEEP=2     # ile wersji paczek zostawic w cache
# ──────────────────────────────────────
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/_fez.sh"

ram() {
    sync; sudo sh -c 'echo 3 > /proc/sys/vm/drop_caches'
    echo "RAM: $(free -h | awk '/^Mem/{print $3"/"$2}')"
}

# swapoff+swapon zwalnia caly swap (dziala tez na zram) — ALE zeby to zrobic,
# kernel musi wpierw przeniesc wszystkie zswapowane strony z powrotem do RAM.
# jesli wolnej RAM jest mniej niz zajetego swapu, to moze zawiesic system
# (thrashing/OOM) zamiast cokolwiek "posprzatac" — wiec sprawdzamy najpierw.
swap() {
    local swap_used_kb mem_avail_kb
    swap_used_kb=$(awk '/^SwapTotal:/{t=$2} /^SwapFree:/{f=$2} END{print t-f}' /proc/meminfo)
    mem_avail_kb=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)
    if [[ "$swap_used_kb" -eq 0 ]]; then
        echo "Swap juz pusty"
        return
    fi
    if (( swap_used_kb > mem_avail_kb )); then
        _err "Za malo wolnej RAM ($((mem_avail_kb/1024))MB) zeby bezpiecznie zwolnic swap ($((swap_used_kb/1024))MB) — pominieto (system moglby sie zawiesic)"
        return 1
    fi
    sudo swapoff -a && sudo swapon -a
    echo "Swap: $(free -h | awk '/^Swap/{print $3"/"$2}')"
}

logs() {
    sudo journalctl --vacuum-time="${LOG_DAYS}d"
    sudo find /var/log -type f \( -name "*.log" -mtime +"$LOG_DAYS" -o -name "*.gz" \) -delete 2>/dev/null
    for steam_dir in ~/.local/share/Steam ~/.var/app/com.valvesoftware.Steam/.local/share/Steam; do
        find "$steam_dir/logs" -type f -name "*.log" -delete 2>/dev/null
        find "$steam_dir/config/htmlcache" -type f -delete 2>/dev/null
    done
    find ~/.local/share -maxdepth 4 -type f -name "*.log" -mtime +"$LOG_DAYS" -delete 2>/dev/null
    find ~/.cache     -maxdepth 3 -type f -name "*.log" -mtime +"$LOG_DAYS" -delete 2>/dev/null
    echo "Logi: $(du -sh /var/log 2>/dev/null | cut -f1)"
}

tmp() {
    sudo find /tmp -mindepth 1 -maxdepth 1 -not -name '.X*' -not -name 'systemd-private-*' -delete 2>/dev/null
    echo "Tmp: $(du -sh /tmp 2>/dev/null | cut -f1)"
}

pacman() {
    sudo paccache -rk"$PACMAN_KEEP"
    sudo paccache -ruk0
}

orphans() {
    local o total=0
    while true; do
        o=$(command pacman -Qdtq 2>/dev/null)
        [[ -z "$o" ]] && break
        sudo pacman -Rns --noconfirm $o || break
        total=$((total + $(wc -w <<< "$o")))
    done
    [[ $total -gt 0 ]] && echo "Usunieto orphans: $total" || echo "Brak orphans"
}

# nigdy nie usuwa zainstalowanych pakietow kernela (rozne flavory jak
# linux-cachyos + linux-cachyos-lts to NIE "stare wersje" siebie nawzajem —
# to osobne, oba celowo zainstalowane kernele). Czysci tylko katalogi
# /usr/lib/modules/<wersja> ktore nie naleza do zadnego pakietu w pacman
# (osierocone smieci po nieudanej aktualizacji / starym DKMS), nigdy biezacy.
kernels() {
    echo "Aktywny kernel: $(uname -r)"
    local dir ver orphaned=()
    for dir in /usr/lib/modules/*/; do
        dir="${dir%/}"; ver="$(basename "$dir")"
        [[ "$ver" == "$(uname -r)" ]] && continue
        command pacman -Qoq "$dir" &>/dev/null || orphaned+=("$dir")
    done
    if [[ ${#orphaned[@]} -eq 0 ]]; then
        echo "Brak osieroconych katalogow modulow"
        return
    fi
    echo "Osierocone katalogi modulow (bez wlasciciela w pacman):"
    printf '  %s\n' "${orphaned[@]}"
    echo -n "Usunac? [t/N] "; read -r yn
    if [[ "$yn" == [tT] ]]; then
        local d; for d in "${orphaned[@]}"; do sudo rm -rf -- "$d"; done
        echo "Usunieto: ${#orphaned[@]} katalog(ow)"
    fi
}

pacnew() {
    local files; mapfile -t files < <(sudo find /etc -type f \( -name '*.pacnew' -o -name '*.pacsave' \) 2>/dev/null | sort)
    if [[ ${#files[@]} -eq 0 ]]; then
        echo "Brak plikow .pacnew/.pacsave"
        return
    fi
    if ! command -v fzf &>/dev/null; then
        printf '%s\n' "${files[@]}"
        return
    fi
    local sel
    sel=$(printf '%s\n' "${files[@]}" | fzf -m \
        --prompt="pacnew> " \
        --header="spacja=zaznacz  enter=usun zaznaczone (zostaje oryginal)  ^o=otworz w \$EDITOR" \
        --preview='orig="{}"; orig="${orig%.pacnew}"; orig="${orig%.pacsave}"; diff -u "$orig" {} 2>/dev/null || echo "(brak oryginalu do porownania)"' \
        --bind="ctrl-o:execute(${EDITOR:-vim} {})")
    [[ -z "$sel" ]] && return
    local f n=0
    while IFS= read -r f; do
        [[ -n "$f" ]] && sudo rm -f -- "$f" && ((n++))
    done <<< "$sel"
    echo "Usunieto: $n plik(ow)"
}

thumb()   { rm -rf ~/.cache/thumbnails/*; echo "Miniaturki wyczyszczone"; }

cache() {
    echo "Cache przed: $(du -sh ~/.cache 2>/dev/null | cut -f1)"
    rm -rf ~/.cache/mozilla ~/.cache/chromium ~/.cache/pip ~/.cache/go ~/.cache/fontconfig 2>/dev/null
    echo "Cache po:    $(du -sh ~/.cache 2>/dev/null | cut -f1)"
}

flatpak() { command flatpak uninstall --unused -y; echo "Flatpak: $(du -sh ~/.var/app 2>/dev/null | cut -f1)"; }

podman()  { command podman image prune -f 2>/dev/null; echo "Podman: usunieto nieuzywane warstwy obrazow"; }

docker() {
    command -v docker &>/dev/null || { _dim "docker: brak — pomijam"; return; }
    command docker image prune -f 2>/dev/null && echo "Docker: usunieto nieuzywane warstwy obrazow" \
        || _dim "Docker: daemon niedostepny — pomijam"
}

aur() {
    command -v paru &>/dev/null || { _dim "paru: brak — pomijam"; return; }
    echo "AUR cache przed: $(du -sh ~/.cache/paru 2>/dev/null | cut -f1)"
    rm -rf ~/.cache/paru/clone/* 2>/dev/null
    echo "AUR cache po:    $(du -sh ~/.cache/paru 2>/dev/null | cut -f1)"
}

coredumps() {
    local before; before=$(sudo du -sh /var/lib/systemd/coredump 2>/dev/null | cut -f1)
    sudo find /var/lib/systemd/coredump -mindepth 1 -delete 2>/dev/null
    echo "Coredumps: ${before:-0} -> $(sudo du -sh /var/lib/systemd/coredump 2>/dev/null | cut -f1)"
}

status() {
    printf "RAM:      %s\n"  "$(free -h | awk '/^Mem/{print $3"/"$2}')"
    printf "SWAP:     %s\n"  "$(free -h | awk '/^Swap/{print $3"/"$2}')"
    printf "Logi:     %s\n"  "$(du -sh /var/log 2>/dev/null | cut -f1)"
    printf "Tmp:      %s\n"  "$(du -sh /tmp 2>/dev/null | cut -f1)"
    printf "Pacman:   %s\n"  "$(du -sh /var/cache/pacman/pkg 2>/dev/null | cut -f1)"
    printf "Cache:    %s\n"  "$(du -sh ~/.cache 2>/dev/null | cut -f1)"
    printf "Flatpak:  %s\n"  "$(du -sh ~/.var/app 2>/dev/null | cut -f1)"
    printf "Thumb:    %s\n"  "$(du -sh ~/.cache/thumbnails 2>/dev/null | cut -f1)"
    printf "AUR:      %s\n"  "$(du -sh ~/.cache/paru 2>/dev/null | cut -f1)"
    printf "Coredumps:%s\n"  "$(sudo du -sh /var/lib/systemd/coredump 2>/dev/null | cut -f1)"
}

info() {
    status; echo
    echo "fezcleaner ram          # czysci RAM cache"
    echo "fezcleaner swap         # zwalnia swap/zram (pomija jesli za malo wolnej RAM)"
    echo "fezcleaner logs         # logi starsze niz ${LOG_DAYS} dni"
    echo "fezcleaner tmp          # czysci /tmp"
    echo "fezcleaner pacman       # cache pacmana: ${PACMAN_KEEP} wersje zainstalowanych + caly cache odinstalowanych"
    echo "fezcleaner orphans      # usuwa osierocone paczki (petla az brak)"
    echo "fezcleaner kernels      # usuwa osierocone katalogi /usr/lib/modules (nigdy zainstalowane pakiety)"
    echo "fezcleaner pacnew       # fzf: przegladaj/usuwaj .pacnew .pacsave (z diffem)"
    echo "fezcleaner thumb        # czysci miniaturki"
    echo "fezcleaner cache        # czysci ~/.cache (mozilla/chromium/pip/go/fontconfig)"
    echo "fezcleaner aur          # czysci cache paru (~/.cache/paru/clone)"
    echo "fezcleaner coredumps    # usuwa zapisane core dumpy (/var/lib/systemd/coredump)"
    echo "fezcleaner flatpak      # usuwa nieuzywane runtimes"
    echo "fezcleaner podman       # czysci nieuzywane obrazy podman"
    echo "fezcleaner docker       # czysci nieuzywane obrazy docker"
    echo "fezcleaner -a           # pelny clean (bez kernels/pacnew — te wymagaja potwierdzenia)"
    echo "fezcleaner -c [flagi]   # -R -S -l -t -p -o -k -N -T -c -A -C -f -P -D -a"
}

all() { ram; swap; logs; tmp; pacman; orphans; thumb; cache; aur; coredumps; flatpak; podman; docker; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(all ram swap logs tmp pacman orphans kernels pacnew thumb cache aur coredumps flatpak podman docker)
    local descs=(
        "pelny clean (wszystko bezpieczne naraz)"
        "czysci RAM cache"
        "zwalnia swap/zram (pomija jesli za malo wolnej RAM)"
        "logi starsze niz ${LOG_DAYS} dni"
        "czysci /tmp"
        "cache pacmana (${PACMAN_KEEP} wersje zainstalowanych + caly cache odinstalowanych)"
        "usuwa osierocone paczki"
        "usuwa osierocone katalogi modulow (bezpieczne, nie rusza zainstalowanych kerneli)"
        "przegladaj/usun .pacnew .pacsave (fzf + diff)"
        "czysci miniaturki"
        "czysci ~/.cache"
        "czysci cache paru (AUR)"
        "usuwa zapisane core dumpy"
        "usuwa nieuzywane runtimes flatpaka"
        "czysci nieuzywane obrazy podman"
        "czysci nieuzywane obrazy docker"
    )
    _fzf_menu "fezcleaner | RAM: $(free -h | awk '/^Mem/{print $3"/"$2}')  SWAP: $(free -h | awk '/^Swap/{print $3"/"$2}')" cmds descs
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -R|--ram)       ram ;;
            -S|--swap)      swap ;;
            -l|--logs)      logs ;;
            -t|--tmp)       tmp ;;
            -p|--pacman)    pacman ;;
            -o|--orphans)   orphans ;;
            -k|--kernels)   kernels ;;
            -N|--pacnew)    pacnew ;;
            -T|--thumb)     thumb ;;
            -c|--cache)     cache ;;
            -A|--aur)       aur ;;
            -C|--coredumps) coredumps ;;
            -f|--flatpak)   flatpak ;;
            -P|--podman)    podman ;;
            -D|--docker)    docker ;;
            -a|--all)       all ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -R -S -l -t -p -o -k -N -T -c -A -C -f -P -D -a"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)  tui ;;
    cli|-c)  cli "$@" ;;
    all|-a)  all ;;
    info|-i) info ;;
    *)       _do "$1" || echo "Uzycie: fezcleaner [ram|swap|logs|tmp|pacman|orphans|kernels|pacnew|thumb|cache|aur|coredumps|flatpak|podman|docker|tui|cli|-a|-i]" ;;
esac
