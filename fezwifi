#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezwifi — WiFi manager (nmcli/iwd/iwlist auto-detect)
# nmcli: tui to jeden ekran fzf z lista sieci — enter=connect ^d=disconnect ^f=zapomnij ^r=rescan
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_mode() {
    command -v nmcli  &>/dev/null && echo nmcli  && return
    command -v iwctl  &>/dev/null && echo iwd    && return
    echo iwlist
}

_iface() { ip link | grep -oE 'w(lan|lp|lo)[0-9][a-z0-9]*' | head -1; }

# SSID (bez zadnego markera) \t sygnal% \t bezpieczenstwo \t "connected"|""
_NMCLI_LIST='nmcli -t -f SSID,SIGNAL,SECURITY,IN-USE dev wifi 2>/dev/null | awk -F: '"'"'$1==""{next} {if(!($1 in seen)){order[++n]=$1} seen[$1]=1; if($2+0>sig[$1]+0||sig[$1]==""){sig[$1]=$2}; sec[$1]=($3==""?"open":$3); if($4=="*"){inuse[$1]=1}} END{for(i=1;i<=n;i++){s=order[i]; printf "%s\t%s%%\t%s\t%s\n",s,sig[s],sec[s],(inuse[s]=="1"?"connected":"")}}'"'"

scan() {
    local mode; mode=$(_mode)
    local iface; iface=$(_iface)
    echo "Skanowanie...  [$mode | $iface]"
    case "$mode" in
        nmcli)  nmcli dev wifi rescan 2>/dev/null ;;
        iwd)    iwctl station "$iface" scan 2>/dev/null ;;
    esac
}

list() {
    local mode; mode=$(_mode)
    local iface; iface=$(_iface)
    scan
    case "$mode" in
        nmcli) eval "$_NMCLI_LIST" | column -t -s$'\t' ;;
        iwd)
            iwctl station "$iface" get-networks | tail -n +5 \
                | sed -r "s/\x1B\[([0-9]{1,3}(;[0-9]{1,2})?)?[mGK]//g"
            ;;
        *)
            sudo iwlist "$iface" scanning | grep 'ESSID' | cut -d'"' -f2 | grep -v '^$' | sort -u
            ;;
    esac
}

browse() {
    command -v fzf &>/dev/null || { _err "Brakuje: fzf  →  sudo pacman -S fzf"; return 1; }
    local mode; mode=$(_mode)
    local iface; iface=$(_iface)

    case "$mode" in
        nmcli)
            eval "$_NMCLI_LIST" | fzf \
                --prompt="fezwifi> " \
                --delimiter=$'\t' \
                --header="enter=connect  ^d=disconnect  ^f=zapomnij  ^r=rescan" \
                --bind="ctrl-r:execute-silent(nmcli dev wifi rescan)+reload($_NMCLI_LIST)" \
                --bind="ctrl-d:execute(nmcli dev disconnect $iface)+reload($_NMCLI_LIST)" \
                --bind="ctrl-f:execute(nmcli connection delete id {1} 2>/dev/null)+reload($_NMCLI_LIST)" \
                --bind="enter:execute(nmcli --ask dev wifi connect {1})+reload($_NMCLI_LIST)" \
                > /dev/null
            ;;
        iwd)
            local list_cmd="iwctl station $iface get-networks | tail -n +5 | sed -r 's/\x1B\[([0-9]{1,3}(;[0-9]{1,2})?)?[mGK]//g'"
            eval "$list_cmd" | fzf \
                --prompt="fezwifi> " \
                --header="enter=connect  ^d=disconnect  ^r=rescan" \
                --bind="ctrl-r:execute-silent(iwctl station $iface scan)+reload($list_cmd)" \
                --bind="ctrl-d:execute(iwctl station $iface disconnect)+reload($list_cmd)" \
                --bind="enter:execute(bash -c 'read -rsp \"Haslo: \" p; echo; printf \"%s\n\" \"\$p\" | iwctl station $iface connect {1}')+reload($list_cmd)" \
                > /dev/null
            ;;
        *)
            _dim "Live TUI dostepne tylko dla nmcli/iwd — fallback: lista + connect"
            list
            connect
            ;;
    esac
}

connect() {
    local ssid="${1}"
    local mode; mode=$(_mode)
    local iface; iface=$(_iface)

    if [[ -z "$ssid" ]]; then
        local nets=()
        case "$mode" in
            nmcli) mapfile -t nets < <(eval "$_NMCLI_LIST" | awk -F'\t' '{print $1}') ;;
            iwd)   mapfile -t nets < <(iwctl station "$iface" get-networks | tail -n +5 \
                       | sed -r "s/\x1B\[([0-9]{1,3}(;[0-9]{1,2})?)?[mGK]//g" | awk '{print $1}') ;;
            *)     mapfile -t nets < <(sudo iwlist "$iface" scanning | grep 'ESSID' | cut -d'"' -f2 | grep -v '^$' | sort -u) ;;
        esac
        [[ ${#nets[@]} -eq 0 ]] && { echo "Brak wykrytych sieci"; return 1; }
        ssid=$(printf '%s\n' "${nets[@]}" | _fzf_pick "siec> ")
    fi
    [[ -z "$ssid" ]] && { echo "Brak SSID"; return 1; }

    case "$mode" in
        nmcli) nmcli --ask dev wifi connect "$ssid" ;;
        iwd)
            read -rs -p "Haslo dla $ssid: " pass; echo
            printf "%s\n" "$pass" | iwctl station "$iface" connect "$ssid"
            ;;
        *)
            read -rs -p "Haslo dla $ssid: " pass; echo
            local conf; conf=$(mktemp /tmp/wpa.XXXXXX.conf)
            wpa_passphrase "$ssid" "$pass" > "$conf"
            sudo wpa_supplicant -B -i "$iface" -c "$conf" >/dev/null 2>&1
            sudo dhclient "$iface" >/dev/null 2>&1
            rm -f "$conf"
            ;;
    esac

    sleep 2
    ping -c1 8.8.8.8 &>/dev/null && echo "Polaczono z: $ssid" || echo "Blad polaczenia z: $ssid"
}

disconnect() {
    local mode; mode=$(_mode)
    local iface; iface=$(_iface)
    case "$mode" in
        nmcli) nmcli dev disconnect "$iface" ;;
        iwd)   iwctl station "$iface" disconnect ;;
        *)     sudo ip link set "$iface" down ;;
    esac
    echo "Rozlaczono"
}

forget() {
    local ssid="${1:-}"
    local mode; mode=$(_mode)
    [[ -z "$ssid" ]] && { echo -n "SSID do zapomnienia: "; read -r ssid; }
    [[ -z "$ssid" ]] && return 1
    case "$mode" in
        nmcli) nmcli connection delete id "$ssid" && _ok "Zapomniano: $ssid" ;;
        *)     _err "Brak obslugi 'forget' dla: $mode" ;;
    esac
}

saved() {
    local mode; mode=$(_mode)
    case "$mode" in
        nmcli) nmcli connection show | grep wifi | awk '{print $1}' ;;
        *)     echo "Brak obslugi 'saved' dla: $mode" ;;
    esac
}

status() {
    local mode; mode=$(_mode)
    local iface; iface=$(_iface)
    echo "Backend: $mode"
    echo "Iface:   $iface"
    case "$mode" in
        nmcli) nmcli -f "DEVICE,STATE,CONNECTION" dev | grep "$iface" ;;
        iwd)   iwctl station "$iface" show ;;
        *)     ip addr show "$iface" 2>/dev/null | grep -E 'state|inet ' ;;
    esac
}

info() {
    status; echo
    echo "fezwifi browse             # fzf: lista sieci na zywo, enter=connect ^d/^f/^r"
    echo "fezwifi list               # skanuj i wylistuj sieci"
    echo "fezwifi connect [ssid]     # polacz sie"
    echo "fezwifi disconnect         # rozlacz"
    echo "fezwifi forget [ssid]      # usun zapisane polaczenie"
    echo "fezwifi saved              # zapisane polaczenia"
    echo "fezwifi status             # status interfejsu"
    echo "fezwifi -c [flagi]         # -l -C [ssid] -d -f [ssid] -s -S"
}

all() { browse; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(browse saved status info)
    local descs=(
        "fzf: lista sieci na zywo (connect/disconnect/zapomnij/rescan)"
        "zapisane polaczenia"
        "status interfejsu"
        "info + komendy"
    )
    _fzf_menu "fezwifi | $(_mode) | $(_iface)" cmds descs
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -l|--list)       list ;;
            -C|--connect)    shift; connect "$1" ;;
            -d|--disconnect) disconnect ;;
            -f|--forget)     shift; forget "$1" ;;
            -s|--saved)      saved ;;
            -S|--status)     status ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -l -C [ssid] -d -f [ssid] -s -S"; return 1 ;;
        esac
        shift
    done
}

case "${1:-info}" in
    tui|-t)     tui ;;
    cli|-c)     cli "$@" ;;
    all|-a)     all ;;
    info|-i)    info ;;
    connect)    connect "${@:2}" ;;
    forget)     forget "${@:2}" ;;
    *)          _do "$1" || echo "Uzycie: fezwifi [list|connect|disconnect|forget|saved|status|tui|cli|-a|-i]" ;;
esac
