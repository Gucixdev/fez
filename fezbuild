#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezbuild — no-nonsense C build tool, inspired by tsoding's nob.c
# rebuduje tylko gdy zrodlo nowsze niz binarka; trap czysci przerwany build
# ─────────────── CONFIG ───────────────
CC="${CC:-cc}"
CFLAGS="${CFLAGS:--Wall -Wextra -g}"
LDFLAGS="${LDFLAGS:-}"
BUILD_DIR="build"
# ──────────────────────────────────────
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/_fez.sh"

BIN_OUT=""   # ustawiane przez build(), sciezka do wynikowej binarki

_srcs_in_dir() {
    local dir="$1"
    find "$dir" -maxdepth 1 -name '*.c' 2>/dev/null | sort
}

_needs_build() {
    local bin="$1"; shift
    [[ -f "$bin" ]] || return 0
    local f
    for f in "$@"; do [[ "$f" -nt "$bin" ]] && return 0; done
    return 1
}

_compile() {
    local bin="$1"; shift
    mkdir -p "$(dirname "$bin")"
    trap '_err "Przerwano — usuwam niedokonczony plik: $bin"; rm -f "$bin"; trap - INT TERM; exit 130' INT TERM
    # shellcheck disable=SC2086
    "$CC" $CFLAGS -o "$bin" "$@" $LDFLAGS
    local rc=$?
    trap - INT TERM
    return $rc
}

build() {
    local target="${1:-.}"
    command -v "$CC" &>/dev/null || { _err "Brakuje kompilatora: $CC"; return 1; }

    if [[ -f "$target" && "$target" == *.c ]]; then
        BIN_OUT="${target%.c}"
        if ! _needs_build "$BIN_OUT" "$target"; then
            _dim "Aktualne: $BIN_OUT"
            return 0
        fi
        _compile "$BIN_OUT" "$target" && _ok "Zbudowano: $BIN_OUT" || { _err "Build nieudany: $target"; return 1; }
    else
        local dir="${target:-.}"
        local srcs=(); mapfile -t srcs < <(_srcs_in_dir "$dir")
        [[ ${#srcs[@]} -eq 0 ]] && { _err "Brak plikow .c w: $dir"; return 1; }
        BIN_OUT="$BUILD_DIR/$(basename "$(realpath "$dir")")"
        if ! _needs_build "$BIN_OUT" "${srcs[@]}"; then
            _dim "Aktualne: $BIN_OUT"
            return 0
        fi
        _compile "$BIN_OUT" "${srcs[@]}" && _ok "Zbudowano: $BIN_OUT (${#srcs[@]} plik(ow))" || { _err "Build nieudany: $dir"; return 1; }
    fi
}

run() {
    local target="${1:-.}"; shift 2>/dev/null || true
    build "$target" || return 1
    "./$BIN_OUT" "$@"
}

watch() {
    command -v inotifywait &>/dev/null || { _err "Brakuje: inotifywait  →  sudo pacman -S inotify-tools"; return 1; }
    local target="${1:-.}"
    trap 'echo; _dim "Watch zatrzymany"; exit 0' INT TERM
    while true; do
        run "$target"
        _dim "--- czekam na zmiane w *.c/*.h ---"
        inotifywait -qq -e modify,create,delete,move . --include '.*\.(c|h)$' 2>/dev/null \
            || inotifywait -qq -e modify "$target" 2>/dev/null
    done
}

clean() {
    if [[ ! -d "$BUILD_DIR" ]]; then
        _dim "Brak $BUILD_DIR/"
        return 0
    fi
    rm -rf "$BUILD_DIR" && _ok "Usunieto: $BUILD_DIR"
}

status() {
    printf "CC:      %s\n" "$CC"
    printf "CFLAGS:  %s\n" "$CFLAGS"
    command -v inotifywait &>/dev/null && echo "watch:   OK" || _dim "watch:   brak inotifywait"
}

info() {
    status; echo
    echo "fezbuild [plik.c|folder]    # domyslnie: build (inkrementalny)"
    echo "fezbuild build [cel]        # to samo jawnie"
    echo "fezbuild run [cel] [-- args]# build + odpal"
    echo "fezbuild watch [cel]        # rebuild+run przy kazdej zmianie *.c/*.h"
    echo "fezbuild clean              # rm -rf $BUILD_DIR/"
    echo "fezbuild -c [flagi]         # -b <cel> -r <cel> -w <cel> -c"
}

all() { build; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(build run watch clean)
    local descs=(
        "buduj (inkrementalnie)"
        "buduj + odpal"
        "rebuild+run przy zmianie plikow"
        "wyczysc build/"
    )
    _fzf_menu "fezbuild | CC=$CC" cmds descs
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -b|--build) shift; build "${1:-.}" ;;
            -r|--run)   shift; run "${1:-.}" ;;
            -w|--watch) shift; watch "${1:-.}" ;;
            -c|--clean) clean ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -b <cel> -r <cel> -w <cel> -c"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)   tui ;;
    cli|-c)   cli "$@" ;;
    all|-a)   all ;;
    info|-i)  info ;;
    build)    build "${2:-.}" ;;
    run)      shift; run "$@" ;;
    watch)    watch "${2:-.}" ;;
    clean)    clean ;;
    status)   status ;;
    "")       tui ;;
    *)        build "$1" ;;
esac
