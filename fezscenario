#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezscenario — record and replay keyboard/mouse/screen scenarios
# ─────────────── CONFIG ───────────────
SCENARIO_DIR="$HOME/.local/share/fezscenario"
# ──────────────────────────────────────
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_check_deps() {
    command -v evemu-record &>/dev/null || { echo "Brakuje: evemu  →  sudo pacman -S evemu"; return 1; }
}

_detect_keyboard() {
    grep 'Handlers=.*leds' /proc/bus/input/devices | grep -o 'event[0-9]*' | head -1 | sed 's/^/\/dev\/input\//'
}

_detect_mouse() {
    grep 'Handlers=.*mouse' /proc/bus/input/devices | grep -v 'kbd' | grep -o 'event[0-9]*' | head -1 | sed 's/^/\/dev\/input\//'
}

devices() {
    echo "Dostepne urzadzenia wejscia:"
    for ev in /dev/input/event*; do
        local name; name=$(cat "/sys/class/input/$(basename "$ev")/device/name" 2>/dev/null)
        printf "  %-20s  %s\n" "$(basename "$ev")" "$name"
    done
    echo
    echo "Auto-wykryto:"
    echo "  Klawiatura: $(_detect_keyboard)"
    echo "  Mysz:       $(_detect_mouse)"
}

_pick_output() {
    local outputs=()
    if command -v wlr-randr &>/dev/null; then
        mapfile -t outputs < <(wlr-randr 2>/dev/null | grep -v '^ ' | awk '{print $1}')
    elif command -v hyprctl &>/dev/null; then
        if command -v jq &>/dev/null; then
            mapfile -t outputs < <(hyprctl monitors -j 2>/dev/null | jq -r '.[].name')
        else
            # bez jq: nazwy monitorow nie sa czysto numeryczne (w odroznieniu od nazw workspace'ow)
            mapfile -t outputs < <(hyprctl monitors -j 2>/dev/null | grep -o '"name": *"[^"]*"' | cut -d'"' -f4 | grep -v '^[0-9]*$')
        fi
    fi
    case "${#outputs[@]}" in
        0) ;;
        1) echo "${outputs[0]}" ;;
        *) printf '%s\n' "${outputs[@]}" | _fzf_pick "monitor> " ;;
    esac
}

_list_dirs() {
    local -n _out="$1"; _out=()
    [[ ! -d "$SCENARIO_DIR" ]] && return
    for d in "$SCENARIO_DIR"/*/; do [[ -d "$d" ]] && _out+=("$d"); done
}

_scn_lines() {
    local dirs; _list_dirs dirs
    local d
    for d in "${dirs[@]}"; do
        local name; name=$(basename "$d")
        local date; date=$(grep -o '"date": "[^"]*"' "$d/meta.json" 2>/dev/null | cut -d'"' -f4 | cut -dT -f1)
        local extras=""; [[ -f "$d/screen.mkv" ]] && extras="+ekran"
        printf "%-35s  %-12s  %s\n" "$name" "$date" "$extras"
    done
}

list() {
    local dirs; _list_dirs dirs
    [[ ${#dirs[@]} -eq 0 ]] && echo "Brak scenariuszy" && return
    local i=1
    for d in "${dirs[@]}"; do
        local name; name=$(basename "$d")
        local date; date=$(grep -o '"date": "[^"]*"' "$d/meta.json" 2>/dev/null | cut -d'"' -f4 | cut -dT -f1)
        local extras=""; [[ -f "$d/screen.mkv" ]] && extras="+ekran"
        printf "%3d) %-35s  %-12s  %s\n" "$i" "$name" "$date" "$extras"
        ((i++))
    done
}

rec() {
    _check_deps || return 1
    mkdir -p "$SCENARIO_DIR"
    local name="${1:-scenario-$(date +%Y%m%d-%H%M%S)}"
    local kb; kb=$(_detect_keyboard)
    local ms; ms=$(_detect_mouse)
    [[ -z "$kb" ]] && echo "Nie znaleziono klawiatury" && devices && return 1

    local dir="$SCENARIO_DIR/$name"
    mkdir -p "$dir"
    echo "Nagrywanie: $name"
    echo "  Klawiatura: $kb"
    [[ -n "$ms" ]] && echo "  Mysz:       $ms"
    echo -n "Nagrywac tez ekran? [t/N] "; read -r yn_screen
    local output=""
    [[ "$yn_screen" == t || "$yn_screen" == T ]] && output=$(_pick_output)

    sudo -v || { echo "Autoryzacja nieudana"; return 1; }

    local pids=()
    sudo evemu-record "$kb" > "$dir/keyboard.evemu" &
    pids+=($!)
    if [[ -n "$ms" ]]; then
        sudo evemu-record "$ms" > "$dir/mouse.evemu" &
        pids+=($!)
    fi
    if [[ "$yn_screen" == t || "$yn_screen" == T ]]; then
        wf-recorder ${output:+-o "$output"} -f "$dir/screen.mkv" &
        pids+=($!)
        echo "Nagrywanie ekranu aktywne${output:+ ($output)}"
    fi

    echo '{"name":"'"$name"'","date":"'"$(date -Iseconds)"'","kb":"'"$kb"'","mouse":"'"$ms"'"}' > "$dir/meta.json"
    printf '%s\n' "${pids[@]}" > "$SCENARIO_DIR/.rec_pids"
    echo "Nagrywanie... (Ctrl+C lub: fezscenario stop)"
    trap 'kill "${pids[@]}" 2>/dev/null' INT
    wait "${pids[@]}" 2>/dev/null
    trap - INT

    for f in "$dir/keyboard.evemu" "$dir/mouse.evemu"; do
        [[ -f "$f" ]] || continue
        local trim; trim=$(tac "$f" | awk '
            /^E [^ ]+ [^ ]+ 1 (29|46|4) / { next }
            /^E [^ ]+ [^ ]+ 0 (29|46|4) / { next }
            /^#/ { next }
            /^E [^ ]+ [^ ]+ 0 0$/ { next }
            { print NR; exit }
        ')
        [[ -n "$trim" && "$trim" -gt 1 ]] && head -n "-$((trim-1))" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    done
    echo "Zapisano: $dir"
}

run() {
    _check_deps || return 1
    local name="${1}"
    if [[ -z "$name" ]]; then
        local dirs; _list_dirs dirs
        [[ ${#dirs[@]} -eq 0 ]] && { echo "Brak scenariuszy"; return 1; }
        local pick; pick=$(_scn_lines | _fzf_pick "odtworz> ")
        name=$(awk '{print $1}' <<< "$pick")
        [[ -z "$name" ]] && echo "Nieprawidlowy wybor" && return 1
    fi
    local dir="$SCENARIO_DIR/$name"
    [[ ! -d "$dir" ]] && echo "Brak scenariusza: $name" && return 1

    sudo -v || { echo "Autoryzacja nieudana"; return 1; }

    echo "Odtwarzanie: $name  (Ctrl+C = stop)"
    local pids=()
    if [[ -f "$dir/keyboard.evemu" ]]; then
        printf '\n' | sudo evemu-play "$dir/keyboard.evemu" &
        pids+=($!)
    fi
    if [[ -f "$dir/mouse.evemu" ]]; then
        printf '\n' | sudo evemu-play "$dir/mouse.evemu" &
        pids+=($!)
    fi
    wait "${pids[@]}" 2>/dev/null
    echo "Odtwarzanie zakonczone"
    reset_keys
}

stop() {
    local pidfile="$SCENARIO_DIR/.rec_pids"
    [[ ! -f "$pidfile" ]] && echo "Brak aktywnego nagrywania" && return 1
    while read -r pid; do kill "$pid" 2>/dev/null && echo "Zatrzymano PID $pid"; done < "$pidfile"
    rm -f "$pidfile"
    echo "Nagrywanie zatrzymane"
}

reset_keys() {
    local kb; kb=$(_detect_keyboard)
    [[ -z "$kb" ]] && echo "Nie znaleziono klawiatury" && return 1
    local codes=(29 97 42 54 56 100 125 126 58 15)
    echo "Zwalnianie stuck keys na $kb..."
    for code in "${codes[@]}"; do
        sudo evemu-event "$kb" --sync --type 1 --code "$code" --value 0 2>/dev/null
    done
    echo "Klawisze zwolnione"
}

play_screen() {
    local name="${1}"
    if [[ -z "$name" ]]; then
        local dirs; _list_dirs dirs
        [[ ${#dirs[@]} -eq 0 ]] && { echo "Brak scenariuszy"; return 1; }
        local pick; pick=$(_scn_lines | _fzf_pick "odtworz ekran> ")
        name=$(awk '{print $1}' <<< "$pick")
    fi
    local f="$SCENARIO_DIR/$name/screen.mkv"
    [[ ! -f "$f" ]] && echo "Brak nagrania ekranu dla: $name" && return 1
    mpv "$f" 2>/dev/null || vlc "$f" 2>/dev/null || xdg-open "$f"
}

delete() {
    local dirs; _list_dirs dirs
    [[ ${#dirs[@]} -eq 0 ]] && echo "Brak scenariuszy" && return
    local to_delete=()

    if command -v fzf &>/dev/null; then
        local picks; mapfile -t picks < <(_scn_lines | fzf -m --prompt="usun (tab=zaznacz, enter=potwierdz)> ")
        local p; for p in "${picks[@]}"; do to_delete+=("$(awk '{print $1}' <<< "$p")"); done
    else
        local selected=(); for d in "${dirs[@]}"; do selected+=(0); done
        while true; do
            echo "=== Wybierz do usuniecia ==="
            local i=1
            for d in "${dirs[@]}"; do
                local mark="[ ]"; [[ "${selected[$((i-1))]}" == 1 ]] && mark="[x]"
                printf "  %s %2d) %s\n" "$mark" "$i" "$(basename "$d")"
                ((i++))
            done
            local zaznaczone; zaznaczone=$(printf '%s\n' "${selected[@]}" | grep -c '^1$')
            echo "(zaznaczono: $zaznaczone | nr=toggle, enter=potwierdz, q=anuluj)"
            echo -n "Nr: "; read -r inp
            case "$inp" in
                q|Q|exit) return ;;
                '') break ;;
                *[!0-9]*) echo "Wpisz numer" ;;
                *)
                    local idx=$((inp-1))
                    if [[ $idx -lt 0 || $idx -ge ${#dirs[@]} ]]; then echo "Nieprawidlowy numer"
                    elif [[ "${selected[$idx]}" == 1 ]]; then selected[$idx]=0
                    else selected[$idx]=1; fi ;;
            esac
        done
        for i in "${!selected[@]}"; do [[ "${selected[$i]}" == 1 ]] && to_delete+=("$(basename "${dirs[$i]}")"); done
    fi

    [[ ${#to_delete[@]} -eq 0 ]] && echo "Nic nie zaznaczono" && return
    echo "Do usuniecia:"; printf '  - %s\n' "${to_delete[@]}"
    echo -n "Potwierdzasz? [t/N] "; read -r yn
    [[ "$yn" != t && "$yn" != T ]] && echo "Anulowano" && return
    for name in "${to_delete[@]}"; do rm -rf "${SCENARIO_DIR:?}/$name" && echo "Usunieto: $name"; done
}

status() {
    echo "Katalog: $SCENARIO_DIR"
    echo "Zapisane: $(ls "$SCENARIO_DIR" 2>/dev/null | grep -vc '^\.')"
    command -v evemu-record &>/dev/null && echo "evemu: OK" || echo "evemu: BRAK"
}

info() {
    status; echo
    echo "fezscenario rec [nazwa]     # nagraj klawiature + mysz (+ ekran opcjonalnie)"
    echo "fezscenario run [nazwa]     # odtworz scenariusz"
    echo "fezscenario stop            # zatrzymaj nagrywanie"
    echo "fezscenario list            # lista scenariuszy"
    echo "fezscenario delete          # usun (multi-select)"
    echo "fezscenario play_screen     # odtworz nagranie ekranu"
    echo "fezscenario devices         # pokaz wykryte urzadzenia"
    echo "fezscenario reset_keys      # zwolnij stuck keys"
    echo "fezscenario -c [flagi]      # -r -R -l -d -p -D"
    command -v evemu-record &>/dev/null || echo; \
    command -v evemu-record &>/dev/null || echo "UWAGA: brakuje evemu  →  sudo pacman -S evemu"
}

all() { rec; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(rec stop run list delete play_screen devices reset_keys info)
    local descs=(
        "nagraj klawiature/mysz/ekran"
        "zatrzymaj nagrywanie"
        "odtworz scenariusz"
        "lista scenariuszy"
        "usun (multi-select)"
        "odtworz nagranie ekranu"
        "pokaz urzadzenia wejscia"
        "zwolnij stuck keys"
        "info + komendy"
    )
    _fzf_menu "fezscenario | scenariusze: $(ls "$SCENARIO_DIR" 2>/dev/null | grep -vc '^\.')" cmds descs
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--rec)     shift; rec "$1" ;;
            -R|--run)     shift; run "$1" ;;
            -l|--list)    list ;;
            -d|--delete)  delete ;;
            -p|--play)    shift; play_screen "$1" ;;
            -D|--devices) devices ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -r [nazwa] -R [nazwa] -l -d -p [nazwa] -D"; return 1 ;;
        esac
        shift
    done
}

case "${1:-info}" in
    tui|-t)      tui ;;
    cli|-c)      cli "$@" ;;
    all|-a)      all ;;
    info|-i)     info ;;
    rec)         rec "${@:2}" ;;
    run)         run "${@:2}" ;;
    play_screen) play_screen "${@:2}" ;;
    *)           _do "$1" || echo "Uzycie: fezscenario [rec|run|stop|list|delete|play_screen|devices|reset_keys|tui|cli|-a|-i]" ;;
esac
