#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# feztoolbox — ~/.toolbox: wrzuc tam dowolny skrypt, "toolbox" daje fzf do wyboru i odpala
# ─────────────── CONFIG ───────────────
TOOLBOX_DIR="$HOME/.toolbox"
# ──────────────────────────────────────
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/_fez.sh"

_scripts() {
    mkdir -p "$TOOLBOX_DIR"
    find -L "$TOOLBOX_DIR" -maxdepth 1 -type f -not -name '.*' 2>/dev/null | sort
}

# skrypty fez* rozumieja "info" i drukuja opis+status (bezpieczne, read-only) —
# to pokazujemy w podgladzie zamiast surowego kodu. inne skrypty (bez info())
# nigdy nie sa odpalane z podgladu, zeby uniknac efektow ubocznych — fallback: head.
_preview() {
    local f="$1"
    if grep -q '^info()' "$f" 2>/dev/null; then
        "$f" info 2>/dev/null && return
    fi
    head -c 2000 "$f" 2>/dev/null
}

run() {
    mkdir -p "$TOOLBOX_DIR"
    command -v fzf &>/dev/null || { _err "Brakuje: fzf  →  sudo pacman -S fzf"; return 1; }
    local files; mapfile -t files < <(_scripts)
    if [[ ${#files[@]} -eq 0 ]]; then
        _dim "Pusto w $TOOLBOX_DIR — wrzuc tam skrypty (przeciagnij w plikach albo: feztoolbox add <plik>)"
        return 1
    fi

    local pick; pick=$(printf '%s\n' "${files[@]}" | fzf \
        --prompt="toolbox> " --with-nth=-1 --delimiter=/ \
        --preview="$(declare -f _preview); _preview {}" --preview-window=down:15 \
        --header="enter=odpal  podglad=info() skryptu")
    [[ -z "$pick" ]] && return 1

    [[ -x "$pick" ]] || chmod +x "$pick" 2>/dev/null
    echo "--- $(basename "$pick") ---"
    "$pick"
}

list() {
    local files; mapfile -t files < <(_scripts)
    if [[ ${#files[@]} -eq 0 ]]; then
        echo "Pusto w $TOOLBOX_DIR"
        return
    fi
    local f
    for f in "${files[@]}"; do
        [[ -x "$f" ]] && printf "  %-30s +x\n" "$(basename "$f")" \
            || printf "  %-30s (bez +x, nadana zostanie przy odpaleniu)\n" "$(basename "$f")"
    done
}

add() {
    if [[ $# -eq 0 ]]; then
        local src; echo -n "Plik do dodania: "; read -r src
        set -- "$src"
    fi
    mkdir -p "$TOOLBOX_DIR"
    local src dest
    for src in "$@"; do
        if [[ -z "$src" || ! -f "$src" ]]; then
            _err "Brak pliku: $src"
            continue
        fi
        dest="$TOOLBOX_DIR/$(basename -- "$src")"
        [[ -e "$dest" || -L "$dest" ]] && rm -f -- "$dest"
        cp -- "$src" "$dest"
        chmod +x "$dest"
        _ok "Dodano: $(basename -- "$src")"
    done
}

link() {
    local dir="${1:-}"
    if [[ -z "$dir" ]]; then
        echo -n "Folder ze skryptami: "; read -r dir
    fi
    [[ -z "$dir" || ! -d "$dir" ]] && { _err "Brak folderu: $dir"; return 1; }
    dir=$(realpath -- "$dir")
    mkdir -p "$TOOLBOX_DIR"
    local f n=0
    for f in "$dir"/*; do
        [[ -f "$f" && -x "$f" ]] || continue
        ln -sf -- "$f" "$TOOLBOX_DIR/$(basename -- "$f")"
        ((n++))
    done
    _ok "Zlinkowano: $n skryptow z $dir"
}

status() {
    printf "Folder:  %s\n" "$TOOLBOX_DIR"
    printf "Skrypty: %s\n" "$(_scripts | wc -l)"
    command -v fzf &>/dev/null && echo "fzf:     OK" || _err "fzf:     BRAK"
}

info() {
    status; echo
    echo "feztoolbox                 # fzf: wybierz i odpal skrypt z ~/.toolbox"
    echo "feztoolbox list            # lista skryptow"
    echo "feztoolbox add <plik...>   # skopiuj plik(i) do ~/.toolbox (+x automatycznie)"
    echo "feztoolbox link <folder>   # zlinkuj wszystkie skrypty z folderu (np. cale repo fez)"
    echo "feztoolbox -c [flagi]      # -a <plik...> -L <folder> -l"
}

all() { run; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() { run; }

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--add)  shift; add "$@"; break ;;
            -L|--link) shift; link "$1" ;;
            -l|--list) list ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -a <plik...> -L <folder> -l"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)  tui ;;
    cli|-c)  cli "$@" ;;
    all|-a)  all ;;
    info|-i) info ;;
    list)    list ;;
    add)     shift; add "$@" ;;
    link)    link "${2:-}" ;;
    *)       _do "$1" || echo "Uzycie: feztoolbox [list|add|link|tui|cli|-a|-i]" ;;
esac
