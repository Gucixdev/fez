#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezcheck — lint/health-check dla dowolnego projektu (domyslnie: biezacy folder)
# ─────────────── CONFIG ───────────────
BIN_DIR="$HOME/.local/bin"   # gdzie sprawdzamy "installed" dla projektow typu fez
# ──────────────────────────────────────
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_dir() { echo "${1:-.}"; }

_detect_lang() {
    local dir; dir=$(_dir "$1")
    [[ -f "$dir/_fez.sh" ]]                                    && echo fez    && return
    [[ -f "$dir/Cargo.toml" ]]                                 && echo rust   && return
    [[ -f "$dir/package.json" ]]                               && echo node   && return
    [[ -f "$dir/pyproject.toml" || -f "$dir/setup.py" || -f "$dir/requirements.txt" ]] && echo python && return
    [[ -f "$dir/go.mod" ]]                                     && echo go     && return
    [[ -f "$dir/CMakeLists.txt" ]]                             && echo cmake  && return
    [[ -f "$dir/Makefile" ]]                                   && echo make   && return
    echo shell
}

# skrypty z shebangiem bash/sh — nie po nazwie, po tresci pliku
_shell_scripts() {
    local dir; dir=$(_dir "$1")
    find "$dir" -maxdepth 4 -type f \
        -not -path '*/.git/*' -not -path '*/node_modules/*' \
        -not -path '*/target/*' -not -path '*/.venv/*' -not -path '*/venv/*' \
        2>/dev/null \
        | while IFS= read -r f; do
            [[ -r "$f" ]] || continue
            head -c 64 "$f" 2>/dev/null | grep -qE '^#!.*/(env +)?(bash|sh)\b' && echo "$f"
        done
}

lint() {
    local dir; dir=$(_dir "$1")
    local f name ok=0 bad=0 tmp
    tmp=$(mktemp)
    local scripts; mapfile -t scripts < <(_shell_scripts "$dir")
    if [[ ${#scripts[@]} -eq 0 ]]; then
        _dim "Brak skryptow shell (bash/sh) w: $dir"
    else
        for f in "${scripts[@]}"; do
            name="${f#"$dir"/}"
            if bash -n "$f" 2>"$tmp"; then
                ((ok++))
            else
                ((bad++))
                _err "SKLADNIA: $name"
                sed 's/^/    /' "$tmp"
            fi
        done
        [[ $bad -eq 0 ]] && _ok "Skladnia: $ok/$((ok+bad)) OK" || _err "Skladnia: $ok/$((ok+bad)) OK, $bad z bledem"
    fi

    if command -v shellcheck &>/dev/null; then
        [[ ${#scripts[@]} -eq 0 ]] && return
        local n; n=$(shellcheck -x "${scripts[@]}" 2>/dev/null | grep -c '^In ')
        if [[ "$n" -eq 0 ]]; then
            _ok "shellcheck: 0 uwag"
        else
            _dim "shellcheck: $n uwag (shellcheck -x <pliki> dla szczegolow)"
        fi
    else
        _dim "shellcheck niezainstalowany — pomijam (sudo pacman -S shellcheck)"
    fi
}

_check_bins() {
    local b
    for b in "$@"; do
        command -v "$b" &>/dev/null && printf "%-16s OK\n" "$b" || printf "%-16s brak\n" "$b"
    done | sort
}

deps() {
    local dir; dir=$(_dir "$1")
    local lang; lang=$(_detect_lang "$dir")
    case "$lang" in
        fez)
            local -A used=(
                [jq]="fezscenario" [fzf]="wiele narzedzi (fzf TUI)" [tldr]="feztldr"
                [curl]="feztldr" [inotifywait]="fezbuild" [cc]="fezbuild"
                [systemctl]="fezmain" [journalctl]="fezmain,fezlog" [bluetoothctl]="fezbt"
                [nmcli]="fezwifi" [iwctl]="fezwifi" [git]="fezdeploy,fezgitflat" [gh]="fezdeploy,fezgitflat"
                [flatpak-builder]="fezgitflat" [evemu-record]="fezscenario" [btrfs]="fezbackup"
                [rsync]="fezbackup,fezdeploy" [wl-copy]="feztldr,fezbackup" [xclip]="feztldr,fezbackup"
                [strace]="feztrace" [ltrace]="feztrace" [shellcheck]="fezcheck"
            )
            local d
            for d in "${!used[@]}"; do
                if command -v "$d" &>/dev/null; then
                    printf "%-16s OK\n" "$d"
                else
                    printf "%-16s brak  (%s)\n" "$d" "${used[$d]}"
                fi
            done | sort
            ;;
        rust)   _check_bins cargo rustc ;;
        node)   _check_bins node npm ;;
        python) _check_bins python3 pip ;;
        go)     _check_bins go ;;
        cmake)  _check_bins cmake make cc ;;
        make)   _check_bins make ;;
        shell)  _check_bins bash shellcheck ;;
        *)      _dim "Nieznany typ projektu w: $dir" ;;
    esac
}

perms() {
    local dir; dir=$(_dir "$1")
    local scripts; mapfile -t scripts < <(_shell_scripts "$dir")
    [[ ${#scripts[@]} -eq 0 ]] && { _dim "Brak skryptow shell w: $dir"; return 0; }
    local f name bad=0
    for f in "${scripts[@]}"; do
        name="${f#"$dir"/}"
        [[ "$(basename "$f")" == _* ]] && continue   # _fez.sh itp. — biblioteka, sourced, nie wykonywana
        [[ -x "$f" ]] || { _err "brak +x: $name"; bad=1; }
    done
    [[ $bad -eq 0 ]] && _ok "Wszystkie skrypty maja +x"
}

installed() {
    local dir; dir=$(_dir "$1")
    local lang; lang=$(_detect_lang "$dir")
    case "$lang" in
        fez)
            local f name bad=0
            while IFS= read -r f; do
                name=$(basename "$f")
                [[ -L "$BIN_DIR/$name" ]] || { _dim "nie zainstalowane: $name"; bad=1; }
            done < <(find "$dir" -maxdepth 1 -type f -name 'fez*' | sort)
            if [[ $bad -eq 0 ]]; then
                _ok "Wszystkie narzedzia zlinkowane w $BIN_DIR"
            else
                echo "Uruchom: $dir/install.sh"
            fi
            ;;
        node)   [[ -d "$dir/node_modules" ]] && _ok "node_modules: OK" || _dim "node_modules: brak (npm install)" ;;
        python) { [[ -d "$dir/.venv" ]] || [[ -d "$dir/venv" ]]; } && _ok "venv: OK" || _dim "venv: brak" ;;
        rust)   [[ -d "$dir/target" ]] && _ok "target/: OK (juz budowane)" || _dim "target/: brak (cargo build)" ;;
        *)      _dim "Nie dotyczy dla: $lang" ;;
    esac
}

status() {
    local dir; dir=$(_dir "$1")
    local lang; lang=$(_detect_lang "$dir")
    printf "Folder:  %s\n" "$(realpath "$dir" 2>/dev/null || echo "$dir")"
    printf "Typ:     %s\n" "$lang"
    printf "Skrypty: %s\n" "$(_shell_scripts "$dir" | wc -l)"
    command -v shellcheck &>/dev/null && echo "shellcheck: OK" || _dim "shellcheck: brak"
}

info() {
    status; echo
    echo "fezcheck lint [folder]      # bash -n + shellcheck na skryptach shell"
    echo "fezcheck deps [folder]      # zaleznosci wg wykrytego typu projektu"
    echo "fezcheck perms [folder]     # czy skrypty shell maja +x"
    echo "fezcheck installed [folder] # stan instalacji (npm/venv/target/symlinki fez)"
    echo "fezcheck -a                 # wszystko naraz (dla biezacego folderu)"
    echo "fezcheck -c [flagi]         # -l -d -p -i [folder]"
}

all() { lint "$1"; echo; deps "$1"; echo; perms "$1"; echo; installed "$1"; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(lint deps perms installed)
    local descs=(
        "skladnia + shellcheck"
        "zaleznosci wg typu projektu"
        "uprawnienia +x"
        "stan instalacji"
    )
    _fzf_menu "fezcheck | $(_detect_lang) | $(realpath . 2>/dev/null || pwd)" cmds descs
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -l|--lint)      shift; lint "${1:-}" ;;
            -d|--deps)      shift; deps "${1:-}" ;;
            -p|--perms)     shift; perms "${1:-}" ;;
            -i|--installed) shift; installed "${1:-}" ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -l -d -p -i [folder]"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)      tui ;;
    cli|-c)      cli "$@" ;;
    all|-a)      all "${2:-}" ;;
    info|-i)     info ;;
    lint)        lint "${2:-}" ;;
    deps)        deps "${2:-}" ;;
    perms)       perms "${2:-}" ;;
    installed)   installed "${2:-}" ;;
    status)      status "${2:-}" ;;
    *)           _do "$1" || echo "Uzycie: fezcheck [lint|deps|perms|installed|status|tui|cli|-a|-i] [folder]" ;;
esac
