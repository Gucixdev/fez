#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezgitflat — GitHub repo -> Flatpak: fzf szukaj, klonuje, wykrywa typ projektu i generuje manifest/build
# ─────────────── CONFIG ───────────────
GITFLAT_DIR="$HOME/.gitflat"        # repo klonowany jako <nazwa>, build w <nazwa>-build
GITFLAT_INDEX="$GITFLAT_DIR/.index"
RUNTIME_VER_FALLBACK="24.08"        # gdy nic zainstalowane lokalnie
# ──────────────────────────────────────
. "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/_fez.sh"
mkdir -p "$GITFLAT_DIR"

# najnowsza wspolna wersja Sdk+Platform juz zainstalowana lokalnie — zeby nie
# generowac manifestu z runtime, ktorego nie ma i trzeba by go dociagac/moze
# byc juz EOL na flathub
_runtime_ver() {
    local v
    v=$(flatpak list --runtime --columns=ref 2>/dev/null \
        | grep -E '^org\.freedesktop\.(Sdk|Platform)/' \
        | awk -F/ '{print $3}' | sort -V | uniq -c | sort -rn \
        | awk '$1==2{print $2; exit}')
    echo "${v:-$RUNTIME_VER_FALLBACK}"
}

_check_deps() {
    local missing=()
    command -v flatpak-builder &>/dev/null || missing+=(flatpak-builder)
    command -v git             &>/dev/null || missing+=(git)
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Brakuje: ${missing[*]}  →  sudo pacman -S ${missing[*]}"
        return 1
    fi
}

_app_id_from_url() {
    local url="$1"
    local user; user=$(echo "$url" | sed 's|.*github.com/||' | cut -d'/' -f1)
    local repo; repo=$(echo "$url" | sed 's|.*github.com/||' | cut -d'/' -f2 | sed 's/\.git$//')
    # flatpak app-id: tylko OSTATNI segment moze zawierac "-" (np. org "Comfy-Org"
    # rozwala flatpak-builder: "Only last name segment can contain -")
    user=$(echo "$user" | sed -E 's/-([a-zA-Z0-9])/\U\1/g')
    echo "io.github.${user}.${repo}"
}

_detect_lang() {
    local dir="$1"
    [[ -f "$dir/Cargo.toml" ]]                                    && echo rust   && return
    [[ -f "$dir/CMakeLists.txt" ]]                                 && echo cmake  && return
    [[ -f "$dir/Makefile" || -f "$dir/makefile" ]]                 && echo make   && return
    [[ -f "$dir/pyproject.toml" || -f "$dir/setup.py" ]]           && echo python && return
    [[ -f "$dir/go.mod" ]]                                         && echo go     && return
    # ostatnia deska ratunku przed "binary" — build lokalny (poza sandboxem)
    # przez docker/podman wg Dockerfile, wynikowa binarka wpakowana do /app
    [[ -f "$dir/Dockerfile" || -f "$dir/Containerfile" ]]          && echo docker && return
    echo binary
}

_dockertool() {
    command -v podman &>/dev/null && { echo podman; return; }
    command -v docker &>/dev/null && { echo docker; return; }
}

# zgaduje plik startowy dla "aplikacji" pythonowej (nie biblioteki) —
# uzywane tylko w fallbacku, gdy `pip install .` odmawia (patrz python w
# _generate_manifest)
_py_entry_guess() {
    local dir="$1" f
    for f in main.py app.py run.py __main__.py; do
        [[ -f "$dir/$f" ]] && { echo "$f"; return; }
    done
}

# wyciaga sciezke z ostatniego ENTRYPOINT/CMD w Dockerfile (json-array lub shell)
_docker_entrypoint() {
    local dockerfile="$1"
    local line; line=$(grep -E '^(ENTRYPOINT|CMD)' "$dockerfile" 2>/dev/null | tail -1)
    [[ -z "$line" ]] && return 1
    if [[ "$line" =~ \[(.*)\] ]]; then
        echo "${BASH_REMATCH[1]}" | tr -d '"' | cut -d',' -f1 | xargs
    else
        echo "$line" | awk '{print $2}'
    fi
}

# generuje manifest dopasowany do wykrytego typu projektu; drukuje wykryty typ na stdout
_generate_manifest() {
    local repo_dir="$1" repo_name="$2" app_id="$3" manifest="$4"
    local RUNTIME_VER; RUNTIME_VER=$(_runtime_ver)
    local lang; lang=$(_detect_lang "$repo_dir")
    mkdir -p "$(dirname "$manifest")"

    case "$lang" in
        rust)
            # nazwa binarki wg Cargo.toml — czesto ROZNI SIE od nazwy repo
            # (np. repo "ripgrep" -> binarka "rg"), wiec zgadywanie po nazwie
            # repo psuje install. cargo metadata dziala lokalnie, bez sandboxa.
            local bin_name="$repo_name"
            if command -v cargo &>/dev/null && command -v jq &>/dev/null; then
                local detected; detected=$(cargo metadata --no-deps --format-version=1 \
                    --manifest-path "$repo_dir/Cargo.toml" 2>/dev/null \
                    | jq -r '.packages[].targets[] | select(.kind[]=="bin") | .name' | head -1)
                [[ -n "$detected" ]] && bin_name="$detected"
            fi
            cat > "$manifest" <<EOF
app-id: $app_id
runtime: org.freedesktop.Platform
runtime-version: '$RUNTIME_VER'
sdk: org.freedesktop.Sdk
sdk-extensions:
  - org.freedesktop.Sdk.Extension.rust-stable
build-options:
  append-path: /usr/lib/sdk/rust-stable/bin
  build-args:
    - --share=network
command: $bin_name
modules:
  - name: $repo_name
    buildsystem: simple
    build-commands:
      - cargo install --path . --root /app
    sources:
      - type: dir
        path: $repo_dir
EOF
            ;;
        cmake)
            cat > "$manifest" <<EOF
app-id: $app_id
runtime: org.freedesktop.Platform
runtime-version: '$RUNTIME_VER'
sdk: org.freedesktop.Sdk
command: $repo_name
modules:
  - name: $repo_name
    buildsystem: cmake-ninja
    config-opts:
      - -DCMAKE_INSTALL_PREFIX=/app
      - -DCMAKE_BUILD_TYPE=Release
    sources:
      - type: dir
        path: $repo_dir
EOF
            ;;
        make)
            cat > "$manifest" <<EOF
app-id: $app_id
runtime: org.freedesktop.Platform
runtime-version: '$RUNTIME_VER'
sdk: org.freedesktop.Sdk
command: $repo_name
modules:
  - name: $repo_name
    buildsystem: simple
    build-commands:
      - make
      - install -Dm755 $repo_name /app/bin/$repo_name
    sources:
      - type: dir
        path: $repo_dir
EOF
            ;;
        python)
            # wiele "aplikacji" pythonowych (nie bibliotek) nie da sie
            # `pip install .` — setuptools odmawia zgadywac package layout
            # gdy w repo jest kilka top-level folderow (typowe dla apek
            # uruchamianych jako `python main.py`, nie importowanych jako
            # pakiet). install.sh probuje normalnego pip install jako
            # pierwsze (dziala dla prawdziwych pakietow), a jesli to sie nie
            # uda — kopiuje repo w calosci do /app/share i robi wrapper
            # ktory odpala wykryty plik startowy bezposrednio.
            local entry; entry=$(_py_entry_guess "$repo_dir")
            local install_script="$GITFLAT_DIR/$repo_name-install.sh"
            cat > "$install_script" <<EOF
#!/bin/sh
set -e
if pip3 install --prefix=/app --no-build-isolation . ; then
    exit 0
fi
echo "pip install . nie zadzialalo (flat-layout / aplikacja, nie pakiet) — kopiuje w calosci i odpalam bezposrednio"
[ -f requirements.txt ] && pip3 install --prefix=/app -r requirements.txt
mkdir -p /app/share/$repo_name /app/bin
cp -r . /app/share/$repo_name
cat > /app/bin/$repo_name <<'WRAP'
#!/bin/sh
exec python3 /app/share/$repo_name/${entry:-main.py} "\$@"
WRAP
chmod +x /app/bin/$repo_name
EOF
            chmod +x "$install_script"

            cat > "$manifest" <<EOF
app-id: $app_id
runtime: org.freedesktop.Platform
runtime-version: '$RUNTIME_VER'
sdk: org.freedesktop.Sdk
build-options:
  build-args:
    - --share=network
command: $repo_name
modules:
  - name: $repo_name
    buildsystem: simple
    build-commands:
      - sh $repo_name-install.sh
    sources:
      - type: dir
        path: $repo_dir
      - type: file
        path: $install_script
EOF
            [[ -z "$entry" ]] && _dim "Nie znaleziono main.py/app.py/run.py/__main__.py — jesli fallback zadziala, popraw entry point w $install_script"
            ;;
        go)
            cat > "$manifest" <<EOF
app-id: $app_id
runtime: org.freedesktop.Platform
runtime-version: '$RUNTIME_VER'
sdk: org.freedesktop.Sdk
sdk-extensions:
  - org.freedesktop.Sdk.Extension.golang
build-options:
  append-path: /usr/lib/sdk/golang/bin
  build-args:
    - --share=network
  env:
    GOBIN: /app/bin
command: $repo_name
modules:
  - name: $repo_name
    buildsystem: simple
    build-commands:
      - go build -o /app/bin/$repo_name .
    sources:
      - type: dir
        path: $repo_dir
EOF
            ;;
        docker)
            local dc; dc=$(_dockertool)
            if [[ -z "$dc" ]]; then
                _err "Wykryto Dockerfile ale brak docker/podman  →  sudo pacman -S podman"
                cat > "$manifest" <<EOF
app-id: $app_id
runtime: org.freedesktop.Platform
runtime-version: '$RUNTIME_VER'
sdk: org.freedesktop.Sdk
command: $repo_name
modules:
  - name: $repo_name
    buildsystem: simple
    build-commands:
      - install -Dm755 $repo_name /app/bin/$repo_name
    sources:
      - type: dir
        path: $repo_dir
EOF
                echo "binary"
                return
            fi

            local dockerfile="$repo_dir/Dockerfile"
            [[ -f "$dockerfile" ]] || dockerfile="$repo_dir/Containerfile"
            local entry; entry=$(_docker_entrypoint "$dockerfile")
            [[ -z "$entry" ]] && entry="/usr/local/bin/$repo_name"

            echo "Buduje obraz lokalnie ($dc, poza sandboxem flatpaka) — moze to potrwac..." >&2
            local img; img="fezgitflat-tmp-$(printf '%s' "$repo_name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-')"
            if ! "$dc" build -t "$img" "$repo_dir" >&2; then
                _err "Build $dc nieudany"
                return 1
            fi

            local cid; cid=$("$dc" create "$img" 2>/dev/null)
            local outbin="$repo_dir/.fezgitflat-bin"
            rm -f "$outbin"
            "$dc" cp "$cid:$entry" "$outbin" 2>/dev/null
            "$dc" rm "$cid" &>/dev/null
            "$dc" rmi "$img" &>/dev/null

            if [[ ! -f "$outbin" ]]; then
                _err "Nie znaleziono $entry w zbudowanym obrazie — sprawdz ENTRYPOINT/CMD w $dockerfile i popraw manifest recznie"
            else
                chmod +x "$outbin"
                if file "$outbin" 2>/dev/null | grep -q 'statically linked'; then
                    _dim "Binarka statycznie linkowana z obrazu $dc — powinna dzialac bez problemu"
                else
                    _dim "UWAGA: binarka dynamicznie linkowana z obrazu $dc — moze nie dzialac jesli biblioteki obrazu roznia sie od Flatpak runtime. Sprawdz recznie jesli sie nie uruchomi."
                fi
            fi

            cat > "$manifest" <<EOF
app-id: $app_id
runtime: org.freedesktop.Platform
runtime-version: '$RUNTIME_VER'
sdk: org.freedesktop.Sdk
command: $(basename "$entry")
modules:
  - name: $repo_name
    buildsystem: simple
    build-commands:
      - install -Dm755 .fezgitflat-bin /app/bin/$(basename "$entry")
    sources:
      - type: dir
        path: $repo_dir
EOF
            ;;
        *)
            cat > "$manifest" <<EOF
app-id: $app_id
runtime: org.freedesktop.Platform
runtime-version: '$RUNTIME_VER'
sdk: org.freedesktop.Sdk
command: $repo_name
modules:
  - name: $repo_name
    buildsystem: simple
    build-commands:
      - install -Dm755 $repo_name /app/bin/$repo_name
    sources:
      - type: dir
        path: $repo_dir
EOF
            ;;
    esac
    echo "$lang"
}

# wspolny runner flatpak-buildera dla build()/refresh() — dwa cele:
# 1) --state-dir przypiety do ~/.gitflat, bo flatpak-builder domyslnie
#    tworzy .flatpak-builder/ (cache/build/ccache, potrafi byc dziesiatki MB)
#    W BIEZACYM KATALOGU ROBOCZYM terminala, nie obok manifestu/build_dir —
#    bez tego smieci sie wszedzie, gdziekolwiek akurat jest cwd (zobaczone
#    naprawde: ~/dev/.flatpak-builder, 55M, po odpaleniu fezgitflat z ~/dev)
# 2) caly output ląduje w <repo>-build.log obok build_dir/manifestu, zeby
#    bylo co sprawdzic po nieudanym (albo i udanym) buildzie bez grzebania
#    w scrollbacku terminala
_fb_build() {
    local build_dir="$1" manifest="$2" repo_name="$3"
    local log="$GITFLAT_DIR/$repo_name-build.log"
    local state_dir="$GITFLAT_DIR/.flatpak-builder"
    {
        echo "=== $(date '+%Y-%m-%d %H:%M:%S') ==="
        echo "manifest: $manifest"
    } > "$log"
    flatpak-builder --state-dir="$state_dir" --force-clean "$build_dir" "$manifest" 2>&1 | tee -a "$log"
    local rc=${PIPESTATUS[0]}
    [[ $rc -ne 0 ]] && return "$rc"
    flatpak-builder --state-dir="$state_dir" --user --install --force-clean "$build_dir" "$manifest" 2>&1 | tee -a "$log"
    return "${PIPESTATUS[0]}"
}

_sdk_extension_for() {
    case "$1" in
        rust) echo "org.freedesktop.Sdk.Extension.rust-stable" ;;
        go)   echo "org.freedesktop.Sdk.Extension.golang" ;;
        *)    echo "" ;;
    esac
}

# upewnia sie, ze rozszerzenie SDK potrzebne dla danego jezyka jest zainstalowane
# (--user jawnie, bo flathub bywa zarejestrowany i jako system i user remote —
# bez --user flatpak pyta interaktywnie ktorego uzyc i sie wiesza w skrypcie)
_ensure_sdk_extension() {
    local lang="$1" ver="$2"
    local ext; ext=$(_sdk_extension_for "$lang")
    [[ -z "$ext" ]] && return 0
    flatpak info --user "$ext//$ver" &>/dev/null && return 0
    echo "Brakuje rozszerzenia SDK: $ext//$ver"
    echo -n "Zainstalowac teraz (flatpak install --user flathub)? [T/n] "; read -r yn
    if [[ "$yn" == n || "$yn" == N ]]; then
        _err "Bez tego rozszerzenia build sie nie powiedzie"
        return 1
    fi
    flatpak install --user -y --noninteractive flathub "$ext//$ver"
}

search() {
    command -v gh &>/dev/null || { _err "Brakuje: gh  →  sudo pacman -S github-cli"; return 1; }
    command -v fzf &>/dev/null || { _err "Brakuje: fzf  →  sudo pacman -S fzf"; return 1; }
    local query="${1:-}"
    [[ -z "$query" ]] && { echo -n "Szukaj na GitHub: " >&2; read -r query; }
    [[ -z "$query" ]] && return 1
    local pick; pick=$(gh search repos "$query" --limit 30 2>/dev/null \
        | fzf --delimiter=$'\t' --with-nth=1,2 --prompt="github ($query)> " \
              --preview='gh repo view {1} 2>/dev/null' --preview-window=down:70%)
    [[ -z "$pick" ]] && return 1
    echo "https://github.com/$(awk -F'\t' '{print $1}' <<< "$pick")"
}

build() {
    _check_deps || return 1
    local url="${1}"
    if [[ -z "$url" ]]; then
        echo -n "GitHub URL (Enter = szukaj po nazwie): "; read -r url
        [[ -z "$url" ]] && { url=$(search); [[ -z "$url" ]] && { echo "Brak wyboru"; return 1; }; }
    fi
    [[ "$url" != *github.com* ]] && { echo "Podaj URL GitHub: https://github.com/user/repo"; return 1; }

    local app_id; app_id=$(_app_id_from_url "$url")
    local repo_name; repo_name=$(echo "$url" | sed 's|.*/||' | sed 's/\.git$//')
    local repo_dir="$GITFLAT_DIR/$repo_name"
    local build_dir="$GITFLAT_DIR/$repo_name-build"
    # manifesty WYGENEROWANE przez fezgitflat zyja TU, poza repo_dir — nigdy w
    # repo_dir/flatpak/, zeby na kolejnym build() nie pomylic wlasnego,
    # (mozliwe ze juz przestarzalego) wyjscia z manifestem dostarczonym przez
    # sam projekt. Jesli juz istnieje (np. z poprzedniego builda), uzywamy go
    # ponownie bez regeneracji — moglo byc recznie poprawione.
    local gen_manifest="$GITFLAT_DIR/$repo_name-manifest.yaml"

    echo "App ID:  $app_id"
    echo "Klonuje: $url"
    git clone --depth=1 "$url" "$repo_dir" 2>/dev/null || {
        echo "Aktualizuje istniejace repo..."
        git -C "$repo_dir" pull
    }

    local manifest="$repo_dir/flatpak/$app_id.yaml"
    [[ -f "$manifest" ]] || manifest=$(find "$repo_dir" -name "*.yaml" -path "*/flatpak/*" 2>/dev/null | head -1)
    [[ -f "$manifest" ]] || manifest=$(find "$repo_dir" -name "*.json" -path "*/flatpak/*" 2>/dev/null | head -1)
    [[ -z "$manifest" && -f "$gen_manifest" ]] && manifest="$gen_manifest"

    if [[ -z "$manifest" ]]; then
        manifest="$gen_manifest"
        local lang; lang=$(_generate_manifest "$repo_dir" "$repo_name" "$app_id" "$manifest")
        _ok "Brak manifestu w repo — wygenerowano dla wykrytego typu: $lang"
        echo "Manifest: $manifest"
        [[ "$lang" == binary ]] && _dim "Nie wykryto znanego build systemu — sprawdz/popraw manifest przed uruchomieniem ponownie"
    else
        local lang; lang=$(_detect_lang "$repo_dir")
    fi

    _ensure_sdk_extension "$lang" "$(_runtime_ver)" || return 1

    echo "Manifest: $manifest"
    _fb_build "$build_dir" "$manifest" "$repo_name" || { _err "Build nieudany — log: $GITFLAT_DIR/$repo_name-build.log"; return 1; }
    _ok "Zainstalowano: $app_id"
    grep -q "^$app_id|" "$GITFLAT_INDEX" 2>/dev/null || echo "$app_id|$url|$manifest" >> "$GITFLAT_INDEX"
}

# jak update, ale BEZ re-clone/pull — tylko ponowny flatpak-builder na
# istniejacym checkoucie i manifescie (przydatne po recznej edycji manifestu)
refresh() {
    local app="${1}"
    if [[ -z "$app" ]]; then
        [[ ! -f "$GITFLAT_INDEX" ]] && { echo "Brak zbudowanych flatpakow"; return 1; }
        local pick; pick=$(awk -F'|' '{printf "%-40s  %s\n", $1, $2}' "$GITFLAT_INDEX" | _fzf_pick "odswiez> ")
        app=$(awk '{print $1}' <<< "$pick")
    fi
    [[ -z "$app" ]] && { echo "Brak wyboru"; return 1; }

    local line url manifest
    line=$(grep "^$app|" "$GITFLAT_INDEX" 2>/dev/null)
    [[ -z "$line" ]] && { echo "Brak wpisu dla: $app"; return 1; }
    url=$(cut -d'|' -f2 <<< "$line")
    manifest=$(cut -d'|' -f3 <<< "$line")
    [[ -f "$manifest" ]] || { _err "Manifest zniknal: $manifest"; return 1; }

    local repo_name; repo_name=$(echo "$url" | sed 's|.*/||' | sed 's/\.git$//')
    local repo_dir="$GITFLAT_DIR/$repo_name"
    local build_dir="$GITFLAT_DIR/$repo_name-build"
    local lang; lang=$(_detect_lang "$repo_dir")
    _ensure_sdk_extension "$lang" "$(_runtime_ver)" || return 1

    echo "Przebudowuje (bez re-clone): $manifest"
    _fb_build "$build_dir" "$manifest" "$repo_name" || { _err "Build nieudany — log: $GITFLAT_DIR/$repo_name-build.log"; return 1; }
    _ok "Przebudowano/zainstalowano: $app"
}

logs() {
    local sel
    if command -v fzf &>/dev/null; then
        sel=$(find "$GITFLAT_DIR" -maxdepth 1 -name '*-build.log' 2>/dev/null | sort \
            | fzf --prompt="log> " --preview='tail -c 4000 {}' --preview-window=down:70%)
    else
        sel=$(find "$GITFLAT_DIR" -maxdepth 1 -name '*-build.log' 2>/dev/null | sort | _fzf_pick "log> ")
    fi
    [[ -z "$sel" ]] && { echo "Brak logow"; return 1; }
    ${PAGER:-less} "$sel" 2>/dev/null || cat "$sel"
}

update() {
    local app="${1}"
    if [[ -z "$app" ]]; then
        [[ ! -f "$GITFLAT_INDEX" ]] && { echo "Brak zbudowanych flatpakow"; return 1; }
        local pick; pick=$(awk -F'|' '{printf "%-40s  %s\n", $1, $2}' "$GITFLAT_INDEX" | _fzf_pick "aktualizuj> ")
        app=$(awk '{print $1}' <<< "$pick")
    fi

    local url; url=$(grep "^$app|" "$GITFLAT_INDEX" 2>/dev/null | cut -d'|' -f2)
    [[ -z "$url" ]] && { echo "Brak wpisu dla: $app"; return 1; }
    build "$url"
}

list() {
    [[ ! -f "$GITFLAT_INDEX" ]] && echo "Brak zbudowanych flatpakow" && return
    echo "Zbudowane flatpaki:"
    while IFS='|' read -r app url manifest; do
        printf "  %-40s  %s\n" "$app" "$url"
    done < "$GITFLAT_INDEX"
}

status() {
    command -v flatpak-builder &>/dev/null && echo "flatpak-builder: OK" || _err "flatpak-builder: BRAK"
    command -v gh &>/dev/null && echo "gh:               OK" || _dim "gh:               brak (search niedostepny)"
    echo "Folder:    $GITFLAT_DIR"
    echo "Zbudowane: $(wc -l "$GITFLAT_INDEX" 2>/dev/null || echo 0)"
}

info() {
    status; echo
    echo "fezgitflat build [url]    # zbuduj + zainstaluj flatpak z GitHub (Enter=szukaj)"
    echo "fezgitflat search [fraza] # fzf: szukaj repo na GitHub (gh search repos)"
    echo "fezgitflat refresh [app]  # przebuduj bez re-clone (np. po recznej edycji manifestu)"
    echo "fezgitflat update [app]   # git pull + przebuduj istniejacy flatpak"
    echo "fezgitflat list           # lista zbudowanych flatpakow"
    echo "fezgitflat logs [app]     # fzf: przegladaj log ostatniego builda"
    echo "fezgitflat status         # status"
    echo "fezgitflat -c [flagi]     # -b <url> -g <fraza> -r <app> -u <app> -L -l"
    echo
    echo "Kazde repo ląduje w ~/.gitflat/<nazwa> (klon), ~/.gitflat/<nazwa>-build"
    echo "(katalog roboczy flatpak-buildera), ~/.gitflat/<nazwa>-build.log (pelny"
    echo "output ostatniego builda) i ~/.gitflat/<nazwa>-manifest.yaml (jesli"
    echo "wygenerowany, bo repo nie mial wlasnego)."
    echo
    echo "Bez wlasnego manifestu w repo wykrywa typ projektu i generuje jeden:"
    echo "  rust (Cargo.toml), cmake (CMakeLists.txt), make (Makefile),"
    echo "  python (pyproject.toml/setup.py), go (go.mod),"
    echo "  docker (Dockerfile/Containerfile — buduje lokalnie docker/podman,"
    echo "  wyciaga binarke z ENTRYPOINT/CMD) — inaczej minimalny manifest"
    echo "  zakladajacy gotowy plik binarny o nazwie repo."
}

all() { list; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(build update refresh list logs)
    local descs=(
        "zbuduj + zainstaluj flatpak z GitHub URL (Enter=szukaj po nazwie)"
        "git pull + przebuduj istniejacy flatpak"
        "przebuduj bez re-clone (po recznej edycji manifestu)"
        "lista zbudowanych flatpakow"
        "przegladaj log ostatniego builda (fzf)"
    )
    _fzf_menu "fezgitflat | $(wc -l "$GITFLAT_INDEX" 2>/dev/null || echo 0) flatpakow" cmds descs
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -b|--build)   shift; build "$1" ;;
            -g|--search)  shift; build "$(search "$1")" ;;
            -r|--refresh) shift; refresh "$1" ;;
            -u|--update)  shift; update "$1" ;;
            -l|--list)    list ;;
            -L|--logs)    logs ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -b <url> -g <fraza> -r <app> -u <app> -l -L"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)  tui ;;
    cli|-c)  cli "$@" ;;
    all|-a)  all ;;
    info|-i) info ;;
    build)   build "${@:2}" ;;
    search)  search "${@:2}" ;;
    refresh) refresh "${@:2}" ;;
    update)  update "${@:2}" ;;
    *)       _do "$1" || echo "Uzycie: fezgitflat [build|update|refresh|list|logs|search|status|tui|cli|-a|-i]" ;;
esac
