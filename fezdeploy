#!/usr/bin/env bash
# fezdeploy — git push, tag, release, publish to registry
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_detect_lang() {
    [[ -f Cargo.toml ]]                                     && echo rust   && return
    [[ -f package.json ]]                                   && echo node   && return
    [[ -f pyproject.toml || -f setup.py ]]                  && echo python && return
    [[ -f .SRCINFO || -f PKGBUILD ]]                        && echo aur    && return
    echo git
}

_detect_host() {
    local remote; remote=$(git remote get-url origin 2>/dev/null)
    case "$remote" in
        *github*)   echo github ;;
        *gitlab*)   echo gitlab ;;
        *gitea*)    echo gitea ;;
        *codeberg*) echo codeberg ;;
        *sr.ht*)    echo sourcehut ;;
        *)          echo git ;;
    esac
}

push() {
    local branch; branch=$(git branch --show-current)
    git push origin "$branch" && echo "Wypchnięto: $branch → $(_detect_host)"
}

tag() {
    local ver="${1}"
    [[ -z "$ver" ]] && { echo -n "Wersja tagu: "; read -r ver; }
    [[ -z "$ver" ]] && { echo "Wersja wymagana"; return 1; }
    git tag -a "$ver" -m "release $ver" && git push origin "$ver" && echo "Tag: $ver"
}

release() {
    local ver="${1}"
    [[ -z "$ver" ]] && { echo -n "Wersja release: "; read -r ver; }
    [[ -z "$ver" ]] && { echo "Wersja wymagana"; return 1; }
    local host; host=$(_detect_host)
    git tag -a "$ver" -m "release $ver" 2>/dev/null
    git push origin "$ver" 2>/dev/null
    case "$host" in
        github)   gh release create "$ver" --generate-notes && echo "GitHub Release: $ver" ;;
        gitlab)   glab release create "$ver" && echo "GitLab Release: $ver" ;;
        gitea)    tea release create --tag "$ver" --title "$ver" && echo "Gitea Release: $ver" ;;
        *)        echo "Release stworzony (tag $ver), push na $host zrobiony" ;;
    esac
}

publish() {
    local lang; lang=$(_detect_lang)
    echo "Publikuje: $lang"
    case "$lang" in
        rust)   cargo publish ;;
        node)   npm publish ;;
        python) python -m twine upload dist/* ;;
        aur)    git push aur master && echo "AUR zaktualizowane" ;;
        *)      echo "Brak obslugi rejestru dla: $lang" ;;
    esac
}

status() {
    local branch; branch=$(git branch --show-current 2>/dev/null || echo "?")
    local ahead;  ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo "?")
    echo "Host:     $(_detect_host)"
    echo "Branch:   $branch"
    echo "Jezyk:    $(_detect_lang)"
    echo "Ahead:    $ahead commitow"
    echo "Remote:   $(git remote get-url origin 2>/dev/null || echo 'brak')"
}

info() {
    status; echo
    echo "fezdeploy push              # git push origin <branch>"
    echo "fezdeploy tag [wersja]      # tag + push"
    echo "fezdeploy release [wersja]  # tag + release (gh/glab/tea)"
    echo "fezdeploy publish           # npm/PyPI/cargo publish / AUR"
    echo "fezdeploy status            # info o repo"
    echo "fezdeploy -a                # push"
    echo "fezdeploy -c [flagi]        # -p -t <v> -r <v> -P -s"
}

all() { push; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local cmds=(push tag release publish status info)
    local descs=(
        "push biezacego brancha"
        "stworz i wypchnij tag"
        "stworz release (gh/glab/tea)"
        "publikuj paczke (npm/PyPI/cargo/AUR)"
        "status repozytorium"
        "info + komendy"
    )
    while true; do
        echo "=== fezdeploy | $(_detect_host) | $(git branch --show-current 2>/dev/null || echo '?') ==="
        for i in "${!cmds[@]}"; do printf "%2d) %-10s  %s\n" $((i+1)) "${cmds[$i]}" "${descs[$i]}"; done
        echo " 0) wyjdz"
        echo -n "Wybierz: "; read -r n
        _tui_dispatch "$n" cmds || break
        echo; echo -n "[Enter]"; read -r
    done
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--push)    push ;;
            -t|--tag)     shift; tag "$1" ;;
            -r|--release) shift; release "$1" ;;
            -P|--publish) publish ;;
            -s|--status)  status ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -p -t <v> -r <v> -P -s"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)  tui ;;
    cli|-c)  cli "$@" ;;
    all|-a)  all ;;
    info|-i) info ;;
    tag)     tag "${@:2}" ;;
    release) release "${@:2}" ;;
    *)       _do "$1" || echo "Uzycie: fezdeploy [push|tag|release|publish|status|tui|cli|-a|-i]" ;;
esac
