#!/usr/bin/env bash
# shellcheck disable=SC2178,SC2128  # "lines" to string budowany w petli, nie tablica
# feztldr — TUI browser for tldr pages; pick example, copy or run
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_fetch() {
    local prog="$1"
    if command -v tldr &>/dev/null; then
        tldr --raw "$prog" 2>/dev/null || tldr "$prog" 2>/dev/null
        return
    fi
    local content
    for platform in common linux osx windows; do
        content=$(curl -sf "https://raw.githubusercontent.com/tldr-pages/tldr/main/pages/$platform/$prog.md" 2>/dev/null)
        [[ -n "$content" ]] && echo "$content" && return
    done
    return 1
}

_parse() {
    local content="$1"
    local -n _descs="$2" _cmds="$3"
    _descs=(); _cmds=()
    local desc=""
    while IFS= read -r line; do
        [[ "$line" =~ ^-\ (.+)$ ]]  && desc="${BASH_REMATCH[1]%:}"
        [[ "$line" =~ ^\`(.+)\`$ ]] && _descs+=("$desc") && _cmds+=("${BASH_REMATCH[1]}") && desc=""
    done <<< "$content"
}

_copy() {
    echo "$1" | wl-copy 2>/dev/null \
     || echo "$1" | xclip -selection clipboard 2>/dev/null \
     || echo "$1" | xsel --clipboard 2>/dev/null \
     && _ok "Skopiowano" || _err "Brak wl-copy/xclip/xsel"
}

browse() {
    local prog="${1}"
    [[ -z "$prog" ]] && { echo -n "Komenda: "; read -r prog; }
    [[ -z "$prog" ]] && return 1

    local content; content=$(_fetch "$prog")
    if [[ -z "$content" ]]; then
        _err "Brak strony tldr dla: $prog"
        command -v tldr &>/dev/null || _dim "Zainstaluj: paru -S tldr"
        return 1
    fi

    local descs cmds
    _parse "$content" descs cmds
    [[ ${#cmds[@]} -eq 0 ]] && { _err "Brak przykladow dla: $prog"; return 1; }

    while true; do
        local lines="" i
        for i in "${!cmds[@]}"; do lines="$lines${cmds[$i]}"$'\t'"${descs[$i]}"$'\n'; done
        local sel cmd
        sel=$(printf '%s' "$lines" | _fzf_pick "tldr $prog> ")
        [[ -z "$sel" ]] && break
        cmd="${sel%%$'\t'*}"
        echo; echo "$ $cmd"
        echo -n "[k]opiuj / [u]ruchom / enter=powrot: "; read -r action
        case "$action" in
            k|K) _copy "$cmd" ;;
            u|U) eval "$cmd" ;;
        esac
        echo
    done
}

search() {
    command -v tldr &>/dev/null || { _err "tldr nie zainstalowany — paru -S tldr"; return 1; }
    local query="${1:-}"
    local matches; matches=$(tldr --list 2>/dev/null | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$')
    [[ -n "$query" ]] && matches=$(echo "$matches" | grep -i "$query")
    [[ -z "$matches" ]] && { _err "Brak wynikow dla: $query"; return 1; }

    local pick
    if command -v fzf &>/dev/null; then
        pick=$(echo "$matches" | fzf --prompt="tldr search> " --preview 'tldr {} 2>/dev/null')
    else
        echo "$matches" | column
        echo -n "Ktora komenda? "; read -r pick
    fi
    [[ -n "$pick" ]] && browse "$pick"
}

status() {
    command -v tldr &>/dev/null && echo "tldr: OK ($(tldr --version 2>/dev/null))" || _err "tldr: BRAK (paru -S tldr)"
    command -v curl &>/dev/null && echo "curl: OK" || _dim "curl: brak (bez fallback HTTP)"
    command -v fzf  &>/dev/null && echo "fzf:  OK" || _dim "fzf:  brak (wybor recznie)"
}

info() {
    status; echo
    echo "feztldr <komenda>          # TUI browser dla tldr strony"
    echo "feztldr browse [komenda]   # to samo"
    echo "feztldr search [query]     # fzf: szukaj + podglad + od razu browse"
    echo "feztldr -c <komenda>       # --browse <komenda>"
}

all() { browse; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    local prog
    if command -v tldr &>/dev/null && command -v fzf &>/dev/null; then
        prog=$(tldr --list 2>/dev/null | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$' \
            | fzf --prompt="feztldr> " --preview 'tldr {} 2>/dev/null')
    else
        echo -n "Komenda do wyszukania: "; read -r prog
    fi
    [[ -z "$prog" ]] && return
    browse "$prog"
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -b|--browse) shift; browse "$1" ;;
            -s|--search) shift; search "$1" ;;
            *) browse "$1" ;;
        esac
        shift
    done
}

case "${1:-info}" in
    tui|-t)    tui ;;
    cli|-c)    cli "$@" ;;
    all|-a)    all ;;
    info|-i)   info ;;
    browse)    browse "${@:2}" ;;
    search)    search "${@:2}" ;;
    status)    status ;;
    "")        tui ;;
    *)         browse "$1" ;;
esac
