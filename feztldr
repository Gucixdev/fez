#!/usr/bin/env bash
# feztldr — TUI browser for tldr pages; pick example, copy or run
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_fetch() {
    local prog="$1"
    if command -v tldr &>/dev/null; then
        tldr --raw "$prog" 2>/dev/null || tldr "$prog" 2>/dev/null
        return
    fi
    local content
    for platform in common linux osx windows; do
        content=$(curl -sf "https://raw.githubusercontent.com/tldr-pages/tldr/main/pages/$platform/$prog.md" 2>/dev/null)
        [[ -n "$content" ]] && echo "$content" && return
    done
    return 1
}

_parse() {
    local content="$1"
    local -n _descs="$2" _cmds="$3"
    _descs=(); _cmds=()
    local desc=""
    while IFS= read -r line; do
        [[ "$line" =~ ^-\ (.+)$ ]]  && desc="${BASH_REMATCH[1]%:}"
        [[ "$line" =~ ^\`(.+)\`$ ]] && _descs+=("$desc") && _cmds+=("${BASH_REMATCH[1]}") && desc=""
    done <<< "$content"
}

_copy() {
    echo "$1" | wl-copy 2>/dev/null \
     || echo "$1" | xclip -selection clipboard 2>/dev/null \
     || echo "$1" | xsel --clipboard 2>/dev/null \
     && echo "Skopiowano" || echo "Brak wl-copy/xclip/xsel"
}

browse() {
    local prog="${1}"
    [[ -z "$prog" ]] && { echo -n "Komenda: "; read -r prog; }
    [[ -z "$prog" ]] && return 1

    local content; content=$(_fetch "$prog")
    if [[ -z "$content" ]]; then
        echo "Brak strony tldr dla: $prog"
        command -v tldr &>/dev/null || echo "Zainstaluj: paru -S tldr"
        return 1
    fi

    local descs cmds
    _parse "$content" descs cmds
    [[ ${#cmds[@]} -eq 0 ]] && { echo "Brak przykladow dla: $prog"; return 1; }

    while true; do
        echo "=== tldr: $prog ==="
        for i in "${!cmds[@]}"; do
            printf "%2d) %s\n    \033[90m%s\033[0m\n" $((i+1)) "${cmds[$i]}" "${descs[$i]}"
        done
        echo " 0) wyjdz"
        echo -n "Wybierz: "; read -r n
        case "$n" in
            0|q|exit|quit) break ;;
            ''|*[!0-9]*) echo "Wpisz numer" ;;
            *)
                local idx=$((n-1))
                if [[ $idx -lt 0 || $idx -ge ${#cmds[@]} ]]; then
                    echo "Nieprawidlowy numer"
                else
                    local cmd="${cmds[$idx]}"
                    echo; echo "$ $cmd"
                    echo -n "[k]opiuj / [u]ruchom / enter=powrot: "; read -r action
                    case "$action" in
                        k|K) _copy "$cmd" ;;
                        u|U) eval "$cmd" ;;
                    esac
                fi ;;
        esac
        echo
    done
}

search() {
    local query="${1}"
    [[ -z "$query" ]] && { echo -n "Szukaj: "; read -r query; }
    [[ -z "$query" ]] && return 1
    command -v tldr &>/dev/null \
        && tldr --list 2>/dev/null | grep -i "$query" | column \
        || echo "tldr nie zainstalowany — paru -S tldr"
}

status() {
    command -v tldr &>/dev/null && echo "tldr: OK ($(tldr --version 2>/dev/null))" || echo "tldr: BRAK (paru -S tldr)"
    command -v curl &>/dev/null && echo "curl: OK" || echo "curl: BRAK (fallback HTTP)"
}

info() {
    status; echo
    echo "feztldr <komenda>          # TUI browser dla tldr strony"
    echo "feztldr browse [komenda]   # to samo"
    echo "feztldr search <query>     # szukaj komendy w tldr"
    echo "feztldr -c <komenda>       # --browse <komenda>"
}

all() { browse; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() {
    echo -n "Komenda do wyszukania: "; read -r prog
    [[ -z "$prog" ]] && return
    browse "$prog"
}

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -b|--browse) shift; browse "$1" ;;
            -s|--search) shift; search "$1" ;;
            *) browse "$1" ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)    tui ;;
    cli|-c)    cli "$@" ;;
    all|-a)    all ;;
    info|-i)   info ;;
    browse)    browse "${@:2}" ;;
    search)    search "${@:2}" ;;
    status)    status ;;
    "")        tui ;;
    *)         browse "$1" ;;
esac
