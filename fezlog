#!/usr/bin/env bash
# shellcheck disable=SC2034  # cmds/descs czytane przez nameref w _fzf_menu (_fez.sh)
# fezlog — log viewer/tailer: journalctl units, whole system, or plain files under /var/log
# kolorowanie po poziomie (ERROR/WARN/DEBUG), fzf do wyboru zrodla, live follow
# ─────────────── CONFIG ───────────────
LOG_DIR="/var/log"
LINES=200
# ──────────────────────────────────────
. "$(dirname "${BASH_SOURCE[0]}")/_fez.sh"

_colorize() {
    awk '
    BEGIN { RED="\033[31m"; YEL="\033[33m"; DIM="\033[2m"; RST="\033[0m" }
    tolower($0) ~ /error|fail|fatal|crit/ { print RED $0 RST; next }
    tolower($0) ~ /warn/                 { print YEL $0 RST; next }
    tolower($0) ~ /debug|trace/          { print DIM $0 RST; next }
    { print }
    '
}

_view_cmd() {
    local src="$1" n="$2" follow="$3"
    if [[ -z "$src" || "$src" == system ]]; then
        journalctl --no-pager -n "$n" ${follow:+-f}
    elif [[ "$src" == user ]]; then
        journalctl --user --no-pager -n "$n" ${follow:+-f}
    elif [[ -f "$src" ]]; then
        if [[ -n "$follow" ]]; then command tail -n0 -F "$src"; else command tail -n "$n" "$src"; fi
    else
        journalctl --no-pager -u "$src" -n "$n" ${follow:+-f}
    fi
}

view() {
    local src="${1:-}"
    _view_cmd "$src" "$LINES" "" | _colorize | "${PAGER:-less}" -R
}

follow() {
    local src="${1:-}"
    trap 'echo; _dim "Zatrzymano"; exit 0' INT TERM
    _view_cmd "$src" 0 1 | _colorize
}

search() {
    local pattern="${1:-}"
    [[ -z "$pattern" ]] && { echo -n "Szukaj: "; read -r pattern; }
    [[ -z "$pattern" ]] && return 1
    echo "== journal =="
    journalctl --no-pager -g "$pattern" 2>/dev/null | _colorize | command tail -n 100
    echo "== pliki ($LOG_DIR) =="
    command grep -riI --color=never "$pattern" "$LOG_DIR" 2>/dev/null | _colorize | command tail -n 100
}

browse() {
    command -v fzf &>/dev/null || { _err "Brakuje: fzf  →  sudo pacman -S fzf"; return 1; }
    local units files sel
    units=$(systemctl list-units --all --no-legend --type=service 2>/dev/null | awk '{print $1}')
    files=$(find "$LOG_DIR" -maxdepth 2 -type f -readable 2>/dev/null)
    sel=$( { echo "system"; echo "$units"; echo "$files"; } | fzf --prompt="fezlog> " \
        --preview 'tail -n 40 {} 2>/dev/null || journalctl --no-pager -u {} -n 40 2>/dev/null' \
        --preview-window=down:50%)
    if [[ -n "$sel" ]]; then
        follow "$sel"
    fi
}

status() {
    command -v journalctl &>/dev/null && echo "journalctl: OK" || _err "journalctl: BRAK"
    command -v fzf &>/dev/null && echo "fzf:        OK" || _dim "fzf:        brak (bez browse)"
    printf "Zrodlo:     %s\n" "$LOG_DIR"
}

info() {
    status; echo
    echo "fezlog [source]           # domyslnie: follow (live tail), 'system'/'user'/unit/plik"
    echo "fezlog view [source]      # ostatnie ${LINES} linii, kolorowane, w pagerze"
    echo "fezlog follow [source]    # live tail -f, kolorowane"
    echo "fezlog browse             # fzf: wybierz unit/plik z podgladem"
    echo "fezlog search [fraza]     # szukaj w journal + plikach z $LOG_DIR"
    echo "fezlog -c [flagi]         # -v <src> -f <src> -b -s <fraza>"
}

all() { browse; }

_do() { declare -f "$1" &>/dev/null && eval "$1" || return 1; }

tui() { browse; }

cli() {
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--view)   shift; view "${1:-}" ;;
            -f|--follow) shift; follow "${1:-}" ;;
            -b|--browse) browse ;;
            -s|--search) shift; search "${1:-}" ;;
            *) echo "Nieznana flaga: $1"; echo "Flagi: -v <src> -f <src> -b -s <fraza>"; return 1 ;;
        esac
        shift
    done
}

case "${1:-tui}" in
    tui|-t)   tui ;;
    cli|-c)   cli "$@" ;;
    all|-a)   all ;;
    info|-i)  info ;;
    view)     view "${2:-}" ;;
    follow)   follow "${2:-}" ;;
    browse)   browse ;;
    search)   search "${2:-}" ;;
    status)   status ;;
    "")       tui ;;
    *)        follow "$1" ;;
esac
